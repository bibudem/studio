---
/*
 * Accueil de studio·bib. Le contenu est dans src/content/accueil.yaml ; ce
 * fichier n'en fait que la mise en page. studio·bib : un accueil qui aide à
 * choisir (le bloc des Ateliers et l'encart final répétaient les mêmes entrées) :
 * - bannière : photo tirée au hasard, logo en h1 en bas à droite, recherche au milieu (Banniere) ;
 * - recherche dans le site, dans la bannière (RechercheSite, celle de l'en-tête) ;
 * - six tâches, deux rangées de trois : tuiles d'action douce (blanches à
 *   contour, jaune pâle au survol ; icône, titre, appel, flèche) ;
 * - deux cartes à photo tirées au hasard parmi quatre (fond photo sous un voile sombre, titre, description, flèche jaune) ;
 * - prochaines formations, en liste simple.
 *
 * Titres : h1 (logo), puis un h2 caché pour les tâches et le h2 des formations.
 */
import { getEntry } from 'astro:content'
import Base from '@/layouts/Base.astro'
import CartePhoto from '@/components/accueil/CartePhoto.astro'
import Banniere from '@/components/accueil/Banniere.astro'
import RechercheSite from '@/components/coquille/RechercheSite.astro'
import { ArrowRightIcon } from '@phosphor-icons/react/dist/ssr/ArrowRight'
import ListeFormationsAccueil from '@/components/contenu/dynamiques/ListeFormationsAccueil.astro'
import { composantIcone } from '@/lib/icones'
import { SITE } from '@/data/site'

const entree = await getEntry('accueil', 'accueil')
if (!entree) throw new Error('Accueil : entrée « accueil » introuvable dans src/content/accueil.yaml.')
const accueil = entree.data

const raccourcis = await Promise.all(accueil.raccourcis.map(async (r) => ({ ...r, Icone: await composantIcone(r.icone) })))
---

<Base titre={accueil.titre} description={accueil.description} niveau={0}>
  <main id="contenu-principal">
    <Banniere images={accueil.banniere.images} phrase={accueil.banniere.phrase} nom={SITE.nom}>
      <RechercheSite id="recherche-accueil" nom="Rechercher dans studio·bib" />
    </Banniere>

    <div class="conteneur accueil-corps" data-revelation="zone">
      <h2 id="titre-taches" class="visuellement-masque">Que voulez-vous faire?</h2>
      <ul class="raccourcis" aria-labelledby="titre-taches" data-revelation="groupe">
        {
          raccourcis.map(({ titre, url, appel, Icone }) => (
            <li>
              <a class="tuile action-douce" href={url}>
                <span class="tuile-texte">
                  <Icone className="tuile-icone" size={32} weight="light" aria-hidden="true" />
                  <span>
                    <span class="tuile-titre">{titre}</span>
                    <span class="tuile-appel">{appel}</span>
                  </span>
                </span>
                <ArrowRightIcon className="tuile-fleche" size={20} aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="cartes-photo" aria-label="Services à découvrir">
        {
          accueil.cartes.map((c) => (
            <li>
              <CartePhoto titre={c.titre} description={c.description} url={c.url} image={c.image} />
            </li>
          ))
        }
      </ul>

      <script is:inline>
        // Deux des quatre cartes, tirées au hasard à chaque visite (sans JavaScript : les deux premières).
        // Le script suit la liste dans le HTML : il s'exécute avant le premier affichage, sans saut visible.
        {
          const liste = document.querySelector('.cartes-photo')
          const cartes = [...liste.children]
          for (let i = cartes.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1))
            ;[cartes[i], cartes[j]] = [cartes[j], cartes[i]]
          }
          cartes.forEach((c, i) => {
            c.hidden = i >= 2
            liste.append(c)
          })
          liste.dataset.tire = ''
        }
      </script>

      <div class="formations">
        <ListeFormationsAccueil
          title={accueil.formations.titre}
          service={accueil.formations.source}
          moreText={accueil.formations.toutes.titre}
          moreLink={accueil.formations.toutes.url}
          limit={4}
          colonnes={2}
          lieu
          niveauTitre={2}
          limiteMobile={3}
        />
      </div>
    </div>
  </main>
</Base>

<style>
  main:focus {
    outline: none;
  }

  .accueil-corps {
    display: flex;
    flex-direction: column;
    gap: var(--espace-6);
    padding-block: var(--espace-6);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---- Tâches : six tuiles, deux par rangée sur mobile, trois dès 600 px ---- */
  .raccourcis {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espace-2);
  }

  @media (min-width: 600px) {
    .raccourcis {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--espace-3);
    }
  }

  /* ---- Cartes à photo : deux par rangée dès 600 px ---- */
  .cartes-photo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--espace-2);
  }

  /* Sans JavaScript : les deux premières cartes seulement (le script en tire deux au hasard) */
  .cartes-photo:not([data-tire]) > :nth-child(n + 3) {
    display: none;
  }

  @media (min-width: 600px) {
    .cartes-photo {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--espace-3);
    }
  }

  .tuile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    height: 100%;
    min-height: 7.5rem;
    padding: var(--espace-2);
    /* Apparence : .action-douce (global.css) ; le jaune plein est réservé à l'action principale */
    border-radius: var(--rayon-carte);
    font-weight: var(--graisse-moyenne);
    text-decoration: none;
  }

  .tuile-texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    overflow-wrap: anywhere;
  }

  /* Icône à côté du texte quand la tuile est assez large */
  @media (min-width: 900px) {
    .tuile-texte {
      flex-direction: row;
      gap: 0.75rem;
    }
  }

  .tuile :global(.tuile-icone) {
    flex: none;
  }

  .tuile-titre,
  .tuile-appel {
    display: block;
  }

  .tuile-appel {
    margin-block-start: 0.25rem;
    color: var(--action-texte);
    font-size: 0.875rem;
    font-weight: var(--graisse-normale);
  }

  .tuile :global(.tuile-fleche) {
    align-self: flex-end;
    transition: translate var(--duree-courte-4) var(--courbe-standard);
  }

  @media (hover: hover) and (pointer: fine) {
    .tuile:hover :global(.tuile-fleche) {
      translate: 0.25rem 0;
    }
  }

  @media (forced-colors: active) {
    .tuile {
      border-color: LinkText;
    }
  }
</style>
