---
/*
 * Gabarit des pages de contenu.
 *
 * - Dès 1200 px : menu de la section à gauche, contenu au centre, sommaire « Sur cette page » à droite. Sous ces largeurs, menu et sommaire
 *   deviennent des volets repliables (sommaire après le titre, menu après le contenu) : rendus en HTML et basculés en
 *   CSS, sans saut au chargement.
 * - Le titre (h1) vient du frontmatter ; le contenu commence à ## (h2).
 * - Fin de page : carte d'aide (frontmatter `aide`), date de dernière mise à
 *   jour, puis rétroaction.
 * - Données structurées : HowTo si les sections sont des étapes numérotées
 *   (« 1. … », « Étape 2 - … »), sinon WebPage ; fil d'Ariane (BreadcrumbList).
 */
import type { MarkdownHeading } from 'astro'
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import Base from './Base.astro'
import FilAriane from '@/components/coquille/FilAriane.astro'
import NavigationSecondaire from '@/components/coquille/NavigationSecondaire.astro'
import Retroaction from '@/components/coquille/Retroaction.astro'
import FiligraneSection from '@/components/coquille/FiligraneSection.astro'
import AgrandirImages from '@/components/partage/AgrandirImages.astro'
import Encart from '@/components/studio/Encart.astro'
import { texteSansAncre } from '@/lib/ancres'
import { filAriane, normaliser, TITRE_SOMMAIRE, type NoeudNavigation, type RacineNavigation } from '@/lib/contenu'
import { formaterDate } from '@/lib/dates'
import { FILIGRANES } from '@/data/filigranes'
import { SITE } from '@/data/site'

interface Props {
  titre: string
  description?: string
  image?: ImageMetadata
  imageAlt?: string
  aide?: 'info' | 'crea'
  retroaction?: boolean
  derniereMaj?: Date
  titres?: MarkdownHeading[]
  sommaire?: boolean
  sommaireMax?: number
  noindex?: boolean
}

const { titre, description, image, imageAlt = '', aide, retroaction = true, derniereMaj, titres = [], sommaire = true, sommaireMax = 2, noindex } = Astro.props
const url = normaliser(Astro.url.pathname)
const segments = url.split('/').filter(Boolean)
const section = segments[0]
// studio·bib : page d'accueil d'une section (/espaces, /informatique…) : elle présente déjà toutes
// ses pages (cartes) ; ni fil d'Ariane ni menu de la section, le contenu prend la largeur
const accueilSection = segments.length === 1

// Sommaire : h2 (et h3 si sommaireMax le permet)
const SECTIONS_MIN_SOMMAIRE = 2
const entrees = titres.filter((t) => t.depth >= 2 && t.depth <= sommaireMax)
const arbre: NoeudNavigation[] = []
for (const [i, t] of entrees.entries()) {
  const n: NoeudNavigation = { titre: texteSansAncre(t.text), url: `#${t.slug}`, ordre: i, enfants: [] }
  if (t.depth === 2 || !arbre.length) arbre.push(n)
  else arbre.at(-1)!.enfants.push(n)
}
const racineSommaire: RacineNavigation | null = sommaire && arbre.length >= SECTIONS_MIN_SOMMAIRE ? { titre: TITRE_SOMMAIRE, enfants: arbre, sommaire: true } : null

// Données structurées
const adresse = new URL(url, SITE.url).href
// Titres d'étapes numérotées (« 1. Préparer », « Étape 2 – Imprimer ») : la page devient un HowTo
const NUMERO_ETAPE = /^(?:étape\s+)?\d+\s*[.)–-]\s*/i
const etapes = titres
  .filter((t) => t.depth === 2)
  .map((t) => ({ id: t.slug, nom: texteSansAncre(t.text) }))
  .filter((t) => NUMERO_ETAPE.test(t.nom) && t.nom.replace(NUMERO_ETAPE, '').trim() !== '')
const commun = { '@context': 'https://schema.org', name: titre, description, url: adresse, inLanguage: 'fr-CA', dateModified: derniereMaj?.toISOString(), isPartOf: { '@id': SITE.SITE_ID }, publisher: { '@id': SITE.ORGANISATION_ID } }
const maillons = await filAriane(url)
const donnees = [
  etapes.length >= 2
    ? { ...commun, '@type': 'HowTo', step: etapes.map((e, i) => ({ '@type': 'HowToStep', position: i + 1, name: e.nom.replace(NUMERO_ETAPE, ''), url: `${adresse}#${e.id}` })) }
    : { ...commun, '@type': 'WebPage' },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: maillons.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.libelle, item: m.url ? new URL(m.url, SITE.url).href : undefined })),
  },
]
---

<Base titre={titre} description={description} niveau={2} donnees={donnees} noindex={noindex}>
  <div class:list={['conteneur', 'page-contenu', { 'sans-navigation': accueilSection, 'cartes-translucides': accueilSection && section in FILIGRANES }]}>
    {accueilSection && <FiligraneSection section={section} />}
    {
      !accueilSection && (
        <aside class="colonne-navigation" aria-label="Navigation de la section">
          <NavigationSecondaire section={section} courante={url} />
        </aside>
      )
    }
    <div class="colonne-contenu">
      {!accueilSection && <FilAriane url={url} />}
      <main id="contenu-principal">
        {/* studio·bib : titre de page plus grand que les h2 du contenu */}
        <h1 class="titre-page">{titre}</h1>
        {
          image && (
            <Picture class="couverture" src={image} alt={imageAlt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[600, 900, 1200].filter((l) => l < image.width).concat(Math.min(image.width, 1200))} sizes="(min-width: 1200px) 1000px, 100vw" loading="eager" fetchpriority="high" />
          )
        }
        {/* studio·bib, sous 1200 px : le sommaire vient après le titre, et non plus avant (le fil d'Ariane seul précède le h1) */}
        {racineSommaire && <div class="sommaire-repliable"><NavigationSecondaire racine={racineSommaire} courante={url} variante="repliable" resume={TITRE_SOMMAIRE} idTitre="titre-sommaire-repliable" /></div>}
        <div class="contenu">
          <slot />
        </div>
        {aide && <Encart nom={`aide-${aide}`} />}
        {/* Dans <main> : tout le contenu d'une page est dans un repère (WCAG 1.3.1, règle axe « region ») */}
        {derniereMaj && (
          <p class="date-maj">
            Dernière mise à jour le <time datetime={derniereMaj.toISOString().slice(0, 10)}>{formaterDate(derniereMaj)}</time>
          </p>
        )}
      </main>
      {/* studio·bib, sous 1200 px : les autres pages de la section, après le contenu */}
      {
        !accueilSection && (
          <div class="section-apres">
            <NavigationSecondaire section={section} courante={url} variante="repliable" />
          </div>
        )
      }
      {retroaction && <Retroaction />}
    </div>
    <AgrandirImages />
    {
      racineSommaire && (
        <aside class="colonne-sommaire" aria-label="Sommaire de la page">
          <NavigationSecondaire racine={racineSommaire} courante={url} idTitre="titre-sommaire" />
        </aside>
      )
    }
  </div>
</Base>

<script>
  // « Sur cette page » suit le défilement : le lien de la section en cours est marqué
  // (aria-current="true"), dans la colonne comme dans le volet repliable. Un titre est « en
  // cours » une fois monté dans les 40 % supérieurs de l'écran ; en haut de page, aucun.
  const liens = [...document.querySelectorAll<HTMLAnchorElement>('.colonne-sommaire a[href^="#"], .sommaire-repliable a[href^="#"]')]
  const titres = [...new Set(liens.map((a) => decodeURIComponent(a.hash.slice(1))))]
    .map((id) => document.getElementById(id))
    .filter((e): e is HTMLElement => !!e)
  if (titres.length) {
    let attente = false
    const maj = () => {
      attente = false
      const seuil = window.innerHeight * 0.4
      let actuel: HTMLElement | undefined
      for (const t of titres) if (t.getBoundingClientRect().top <= seuil) actuel = t
      // Tout en bas de la page, la dernière section est celle en cours même si son titre n'a pas atteint le seuil
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) actuel = titres.at(-1)
      for (const a of liens) {
        if (actuel && decodeURIComponent(a.hash.slice(1)) === actuel.id) a.setAttribute('aria-current', 'true')
        else if (a.getAttribute('aria-current') === 'true') a.removeAttribute('aria-current')
      }
      // La colonne garde le lien en cours à l'écran quand le sommaire défile lui-même
      const colonne = document.querySelector<HTMLElement>('.colonne-sommaire')
      const courant = colonne?.querySelector<HTMLElement>('[aria-current="true"]')
      if (colonne && courant && colonne.scrollHeight > colonne.clientHeight) {
        const c = colonne.getBoundingClientRect()
        const l = courant.getBoundingClientRect()
        if (l.top < c.top || l.bottom > c.bottom) colonne.scrollTop += l.top - c.top - c.height / 2
      }
    }
    const planifier = () => {
      if (!attente) {
        attente = true
        requestAnimationFrame(maj)
      }
    }
    addEventListener('scroll', planifier, { passive: true })
    addEventListener('resize', planifier)
    maj()
  }
</script>

<style>
  main:focus {
    outline: none;
  }

  /* Accueil de section : les cartes laissent voir un peu de l'icône en filigrane (fond à 70 %).
     Le texte reste au contraste du jeton : l'icône est elle-même presque invisible. Cartes à icône
     (--_fond) ou à image (fond de surface). */
  .cartes-translucides :global(.carte) {
    background-color: color-mix(in srgb, var(--_fond, var(--couleur-surface)) 70%, transparent);
  }

  .page-contenu {
    /* Le calque décoratif (z-index -1) reste dans le conteneur, au-dessus du fond de la page */
    position: relative;
    isolation: isolate;
    /* Peu d'espace sous la page : le pied de page suit la rétroaction de près */
    padding-block: var(--espace-6) var(--espace-3);
  }

  .colonne-navigation,
  .colonne-sommaire {
    display: none;
  }

  h1 {
    margin-block: var(--espace-element) var(--espace-titre);
  }

  /* Un vrai titre de page : nettement plus grand que les h2 du contenu (2,5 rem, 3,5 rem dès 900 px) */
  .titre-page {
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    font-weight: var(--graisse-forte);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .section-apres {
    margin-block-start: var(--espace-bloc);
  }

  .section-apres:empty {
    display: none;
  }

  .couverture {
    display: block;
    width: 100%;
    height: auto;
    /* Même hauteur pour toutes les couvertures, celle de l'Amphithéâtre (4:1) :
       les images d'un autre format sont recadrées au centre */
    aspect-ratio: 4 / 1;
    object-fit: cover;
    margin-block-end: var(--espace-bloc);
    border-radius: var(--rayon-carte);
  }

  .date-maj {
    margin-block-start: var(--espace-bloc);
    color: var(--couleur-texte-secondaire);
    font-size: 0.875rem;
    text-align: end;
  }

  @media (min-width: 1200px) {
    .page-contenu {
      display: grid;
      /* minmax(0, …) : une colonne en fr ne descend pas sous son contenu (WCAG 1.4.10) */
      grid-template-columns: minmax(0, 3fr) minmax(0, 7fr) minmax(0, 2fr);
      gap: var(--espace-4);
      align-items: start;
    }

    .colonne-navigation {
      display: block;
      position: sticky;
      top: calc(var(--hauteur-entete) + 1rem);
    }

    /* Mêmes colonnes avec ou sans sommaire : le menu et le début du contenu ne bougent pas d'une
       page à l'autre. Sans sommaire, le contenu déborde sur la troisième colonne (plus large) ;
       la couverture garde alors la largeur de la deuxième colonne : 7/9 de l'étendue, moins l'écart. */
    .page-contenu:not(.sans-navigation):not(:has(.colonne-sommaire)) .colonne-contenu {
      grid-column: 2 / -1;
    }

    .page-contenu:not(.sans-navigation):not(:has(.colonne-sommaire)) .couverture {
      width: calc((100% - var(--espace-4)) * 7 / 9);
    }

    /* Le sommaire reste à l'écran pendant le défilement ; plus haut que l'écran, il défile lui-même */
    .colonne-sommaire {
      display: block;
      position: sticky;
      top: calc(var(--hauteur-entete) + 1rem);
      max-height: calc(100vh - var(--hauteur-entete) - 2rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    /* Accueil de section : pas de colonne de navigation, le contenu (et la couverture) prennent la largeur */
    .page-contenu.sans-navigation {
      grid-template-columns: minmax(0, 1fr);
    }

    .page-contenu.sans-navigation:has(.colonne-sommaire) {
      grid-template-columns: minmax(0, 10fr) minmax(0, 2fr);
    }

    .page-contenu.sans-navigation .couverture {
      width: 100%;
    }
  }

  /* Accueil de section : l'encart de fin (« Nous sommes là pour vous aider ») ne s'étire pas sur
     toute la largeur ; plus étroit et centré, il se lit comme une invitation et non comme une bande */
  .sans-navigation :global(.encart.bande) {
    max-inline-size: 48rem;
    margin-inline: auto;
  }
</style>
