---
/*
 * Squelette HTML commun : <head> (SEO,
 * partage, données structurées), lien d'évitement, coquille commune aux sites
 * des Bibliothèques (avis institutionnels, en-tête, pied de page, consentement,
 * retour en haut) et outils de studio·bib (clavardage, outil d'accessibilité).
 *
 * Navigation côté client (ClientRouter) : la page ne se recharge pas d'un
 * lien à l'autre, et la conversation du clavardage continue. Les scripts du
 * site se rebranchent à chaque page (src/lib/pages.ts).
 */
import '@/styles/global.css'
import '@/styles/animations.css'
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url'
import Entete from '@/components/coquille/Entete.astro'
import PiedDePage from '@/components/coquille/PiedDePage.astro'
import ServicesInstitutionnels from '@/components/coquille/ServicesInstitutionnels.astro'
import RetourHaut from '@/components/coquille/RetourHaut.astro'
import LienEvitement from 'harmonium/astro/LienEvitement.astro'
import clavardage from 'harmonium/dist/bib-clavardage.min.js?url'
import { SITE } from '@/data/site'
import { normaliser } from '@/lib/contenu'
import { jsonLd } from '@/lib/json-ld'
import { ClientRouter } from 'astro:transitions'

interface Props {
  titre?: string
  description?: string
  noindex?: boolean
  /** Niveau de page (0 = accueil) : règle la place de la bannière d'avis */
  niveau?: number
  /** Image de partage (URL absolue ou à la racine du site) */
  image?: string
  /** Données structurées propres à la page (schema.org) */
  donnees?: object
}

const { titre, description = SITE.description, noindex = false, niveau = 0, image = '/img/miniature.jpg', donnees } = Astro.props
// Accueil (niveau 0) : le titre complet décrit le site ; ailleurs « Titre de la page | studio·bib »
const titreComplet = niveau === 0 ? SITE.titreAccueil : titre && titre !== SITE.nom ? `${titre} | ${SITE.nom}` : SITE.nom
const imageAbsolue = new URL(image, Astro.site).href
const canonique = new URL(normaliser(Astro.url.pathname), Astro.site)
// Hors production, rien n'est indexé : le site actuel reste la référence (voir astro.config.mjs)
const indexable = !noindex && process.env.SITE_ENV === 'production'
---

<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonique} />}
    {!indexable && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:title" content={niveau === 0 ? SITE.titreAccueil : (titre ?? SITE.nom)} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    {/* Image de partage (Teams, réseaux sociaux) : le logo studio·bib, 1200 × 630 (public/img/miniature.jpg) */}
    <meta property="og:image" content={imageAbsolue} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo de studio·bib, services technologiques et créatifs des bibliothèques de l'Université de Montréal" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={niveau === 0 ? SITE.titreAccueil : (titre ?? SITE.nom)} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageAbsolue} />
    <meta name="twitter:image:alt" content="Logo de studio·bib" />
    {/* Icône du site : logo studio·bib. SVG pour les navigateurs récents, .ico en repli, PNG pour iOS et Android */}
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b113a" />
    <link rel="alternate" type="text/plain" title="Sommaire pour les assistants d'IA" href="/llms.txt" />
    <script is:inline type="application/ld+json" set:html={jsonLd(SITE.donneesStructurees)} />
    {donnees && <script is:inline type="application/ld+json" set:html={jsonLd(donnees)} />}
    {/* Outil d'accessibilité désactivé pour l'instant ; réactiver ces deux lignes :
    <link rel="stylesheet" href="/accessibilite/widget.css" />
    <script is:inline defer src="/accessibilite/widget.js"></script> */}
    {/* Sens du glissement entre deux pages */}
    <script is:inline>
      window.addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return
        const profondeur = (url) => new URL(url).pathname.split('/').filter(Boolean).length
        const a = window.navigation?.activation
        let retour = false
        if (a?.navigationType === 'traverse' && a.from) retour = a.entry.index < a.from.index
        else if (a?.from?.url) retour = profondeur(location.href) < profondeur(a.from.url)
        e.viewTransition.types.add(retour ? 'retour' : 'avance')
        if (a?.navigationType === 'traverse') {
          document.documentElement.dataset.vtHistorique = ''
          e.viewTransition.finished.finally(() => delete document.documentElement.dataset.vtHistorique)
        }
      })
    </script>
    {/* Navigation côté client : voir l'en-tête de ce fichier */}
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body>
    <LienEvitement cible="contenu-principal">Aller au contenu principal</LienEvitement>
    <ServicesInstitutionnels position="haut" niveau={niveau} />
    <Entete />
    <slot name="avant-contenu" />
    <ServicesInstitutionnels position="avis" niveau={niveau} />
    <slot />
    <PiedDePage />
    <ServicesInstitutionnels position="bas" niveau={niveau} />
    <RetourHaut />
    {/* Clavardage flottant de harmonium (LibChat des Bibliothèques), sur toutes les pages.
        Script classique et non module : il lit ses réglages data-* sur sa propre balise.
        Il ne s'exécute qu'une fois par visite (même adresse sur chaque page). */}
    <script is:inline async src={clavardage}></script>
    <script>
      /*
       * Navigation côté client : à chaque changement de page, Astro remplace
       * le <body> et retire du <head> ce que la nouvelle page n'a pas. Pour
       * que la conversation continue, le bloc de LibChat sort du <body> dès son
       * apparition, avec les deux feuilles de style du clavardage (celle de
       * harmonium, data-bib-clavardage, et celle de LibChat) : ils deviennent
       * des enfants de <html>, après le <body>, qu'Astro ne touche jamais.
       * L'iframe de la conversation n'est ni déplacée ni rechargée ensuite.
       * Le bloc est en position fixe : sa place à l'écran ne change pas.
       */
      const ID = 's-lch-widget-9467'
      const sortir = () => {
        const bloc = document.getElementById(ID)
        const harmonium = document.querySelector('style[data-bib-clavardage]')
        // Celle de LibChat, ajoutée à la fin du <head> (celle de harmonium aussi
        // mentionne la classe, d'où l'exclusion)
        const libchat = [...document.head.querySelectorAll('style')].find((st) => !st.hasAttribute('data-bib-clavardage') && st.textContent?.includes('.s-lch-widget-float'))
        if (!bloc || !harmonium || !libchat) return false
        if (bloc.parentElement !== document.documentElement) document.documentElement.append(harmonium, libchat, bloc)
        return true
      }
      if (!sortir()) {
        const obs = new MutationObserver(() => sortir() && obs.disconnect())
        obs.observe(document.documentElement, { childList: true, subtree: true })
        // LibChat indisponible : on cesse d'attendre (harmonium abandonne aussi après 30 s)
        setTimeout(() => obs.disconnect(), 35_000)
      }
    </script>
    {/* Lien d'évitement : le focus passe au contenu principal. Délégation sur
        le document : vaut pour le lien de chaque page */}
    <script>
      import '@/lib/animations'
      import { focaliserTemporairement } from '@/lib/focus'
      import { copierLienAncre } from '@/lib/ancres-copie'
      import { aChaquePage } from '@/lib/pages'

      document.addEventListener('click', (e) => {
        if (!(e.target as Element | null)?.closest?.('.bib-lien-evitement')) return
        const principal = document.getElementById('contenu-principal')
        if (principal) focaliserTemporairement(principal, { preventScroll: true })
      })
      aChaquePage((signal) => copierLienAncre(signal))
    </script>
    {/* Liens vers un fichier (PDF, document, flux…) : navigation ordinaire.
        Sinon le routeur télécharge le fichier entier avant de passer la main
        au navigateur. En capture, pour poser l'attribut avant que le routeur
        lise le clic. */}
    <script>
      document.addEventListener(
        'click',
        (e) => {
          const lien = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null
          if (!lien || lien.origin !== location.origin) return
          if (/\.(?!html?$)[a-z0-9]{2,5}$/i.test(lien.pathname)) lien.setAttribute('data-astro-reload', '')
        },
        true,
      )

      // Astro recopie les attributs de <html> depuis la nouvelle page, qui n'a
      // pas data-menu-js (posé par le script de l'en-tête) : sans ce report,
      // l'en-tête montrerait sa forme sans JavaScript le temps d'une image
      document.addEventListener('astro:before-swap', (e) => {
        if (document.documentElement.hasAttribute('data-menu-js')) e.newDocument.documentElement.setAttribute('data-menu-js', '')
      })
    </script>
  </body>
</html>
