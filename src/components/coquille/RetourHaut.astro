---
/*
 * Bouton « Retour en haut de la page », fixé en bas à droite.
 *
 * - Il apparaît quand on a défilé de plus d'un écran et demi, et disparaît en
 *   haut de page. Masqué, il est `visibility: hidden` : il sort aussi de
 *   l'ordre de tabulation et de l'arbre d'accessibilité. Sans JS, il reste
 *   masqué (le défilement natif suffit : Début, ou le lien d'évitement).
 * - Un vrai <button> avec un nom accessible (l'icône est décorative). Cible de
 *   48 px, 40 × 48 px en onglet (WCAG 2.5.8 demande 24 px).
 * - Au clic : défilement jusqu'en haut (instantané avec mouvement réduit, via
 *   la règle globale de scroll-behavior), puis le focus revient au début du
 *   document sans le montrer : le Tab suivant atteint le lien d'évitement,
 *   comme à l'arrivée sur la page. Laisser le focus sur le bouton, devenu
 *   masqué, le ferait disparaître sous le clavier (WCAG 2.4.3).
 * - Il se place juste au-dessus du rond de clavardage de harmonium
 *   (bib-clavardage, chargé dans Base), comme sur le site des Bibliothèques.
 * - ≥ 900 px : onglet collé au bord droit (40 × 48 px), dans la marge de
 *   64 px : il ne recouvre jamais le texte.
 *   < 900 px : pastille en bas à droite, montrée seulement quand on remonte
 *   (ou en bas de page) ; pendant la lecture (défilement vers le bas), elle
 *   se retire et ne recouvre plus le texte ni les cartes. Elle se retire
 *   aussi après 2,5 s sans défilement, sauf si elle a le focus.
 * - Bleu principal, comme le tiroir des liens rapides (bleu foncé au
 *   survol). Contraste du pictogramme blanc : 7,1:1 au repos.
 * - Infobulle « Retour en haut » à gauche, au survol et au focus clavier,
 *   comme la poignée du tiroir : Échap la ferme, le pointeur peut passer
 *   dessus (WCAG 1.4.13).
 * - Focus : anneau marine avec un liseré blanc, lisible sur fond clair comme
 *   sur les bandes foncées.
 * - Mode contraste forcé : bordure système. Impression : masqué.
 */
import { ArrowUpIcon } from '@phosphor-icons/react/dist/ssr/ArrowUp'
---

<button type="button" class="retour-haut" data-retour-haut aria-label="Retour en haut de la page">
  <ArrowUpIcon size={24} weight="bold" aria-hidden="true" />
</button>

<script>
  import { aChaquePage, auDepart } from '@/lib/pages'

  aChaquePage((signal) => {
    const bouton = document.querySelector<HTMLButtonElement>('[data-retour-haut]')
    if (!bouton) return
    let enAttente = false
    let precedent = window.scrollY
    let remonte = false
    // Sous 900 px, le bouton flotte sur le contenu : il ne se montre qu'en
    // remontant (on cherche alors le haut) ou en bas de page ; dès 900 px,
    // il est dans la marge et reste affiché.
    const large = window.matchMedia('(width >= 900px)')
    const SEUIL = 8
    // Sous 900 px, il se retire aussi après REPOS ms sans défilement : arrêté
    // sur un passage, on lit, et il ne doit pas rester posé sur le contenu
    const REPOS = 2500
    let auRepos = false
    let minuterieRepos: ReturnType<typeof setTimeout> | undefined
    const mettreAJour = () => {
      enAttente = false
      const y = window.scrollY
      if (Math.abs(y - precedent) >= SEUIL) {
        remonte = y < precedent
        precedent = y
      }
      const enBas = window.innerHeight + y >= document.documentElement.scrollHeight - 2
      const loin = y > window.innerHeight * 1.5
      // Le focus (ou le doigt, le pointeur) le garde affiché : il ne
      // disparaît pas sous le clavier ni au moment de le toucher
      const garde = bouton.matches(':focus-visible, :hover, :active')
      const montrer = large.matches || garde || ((remonte || enBas) && !auRepos)
      bouton.toggleAttribute('data-visible', loin && montrer)
    }
    large.addEventListener('change', mettreAJour, { signal })
    window.addEventListener(
      'scroll',
      () => {
        auRepos = false
        clearTimeout(minuterieRepos)
        minuterieRepos = setTimeout(() => {
          auRepos = true
          mettreAJour()
        }, REPOS)
        if (enAttente) return
        enAttente = true
        requestAnimationFrame(mettreAJour)
      },
      { passive: true, signal },
    )
    auDepart(signal, () => clearTimeout(minuterieRepos))
    // Quitter le bouton sans l'avoir utilisé : la minuterie a pu passer
    bouton.addEventListener('blur', mettreAJour)
    window.addEventListener('resize', mettreAJour, { passive: true, signal })

    // Échap ferme l'infobulle ; elle revient au prochain survol ou focus
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape' && bouton.matches(':hover, :focus-visible')) bouton.setAttribute('data-infobulle-fermee', '')
      },
      { signal },
    )
    for (const evenement of ['pointerleave', 'blur']) {
      bouton.addEventListener(evenement, () => bouton.removeAttribute('data-infobulle-fermee'))
    }
    mettreAJour()

    bouton.addEventListener('click', () => {
      window.scrollTo({ top: 0 })
      // Point de départ de la navigation au clavier : le haut du document
      const corps = document.body
      corps.setAttribute('tabindex', '-1')
      corps.style.outline = 'none'
      corps.focus({ preventScroll: true })
      corps.addEventListener(
        'blur',
        () => {
          corps.removeAttribute('tabindex')
          corps.style.removeProperty('outline')
        },
        { once: true },
      )
    })
  })
</script>

<style>
  .retour-haut {
    --_ecart: 1rem;
    display: grid;
    position: fixed;
    /* Un cran au-dessus du clavardage flottant (même niveau que l'en-tête) :
       son infobulle passe toujours devant le rond */
    z-index: calc(var(--z-entete) + 1);
    right: var(--_ecart);
    /* < 900 px : au-dessus du rond de clavardage (3 rem + 0,75 rem d'écart).
       Le rond, et donc le bouton, montent au-dessus de la carte de
       consentement tant qu'elle est affichée (--bib-consentement-hauteur,
       publiée par harmonium) : même calcul que bib-clavardage. */
    --_base: max(var(--_ecart), calc(var(--bib-consentement-hauteur, 0px) + 0.75rem));
    bottom: calc(var(--_base) + 3.75rem + env(safe-area-inset-bottom, 0px));
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: var(--jaune);
    box-shadow: var(--ombre-2);
    color: var(--bleu-fonce);
    cursor: pointer;
    visibility: hidden;
    opacity: 0;
    translate: 0 0.75rem;
    transition:
      opacity var(--duree-courte) var(--courbe-sortie),
      translate var(--duree-courte) var(--courbe-sortie),
      visibility 0s linear var(--duree-courte),
      background-color var(--duree-courte) var(--courbe-standard);
  }

  .retour-haut[data-visible] {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
    transition:
      opacity var(--duree-moyenne) var(--courbe-entree),
      translate var(--duree-moyenne) var(--courbe-entree),
      visibility 0s,
      background-color var(--duree-courte) var(--courbe-standard);
  }

  @media (hover: hover) and (pointer: fine) {
    .retour-haut:hover {
      background-color: var(--jaune-40);
    }
  }

  /* Infobulle (voir la poignée du tiroir dans LiensRapides) : nom déjà porté
     par aria-label, d'où le texte de remplacement vide ; ::before relie la
     bulle au bouton pour le pointeur */
  .retour-haut::before {
    content: '';
    position: absolute;
    top: 0;
    right: 100%;
    bottom: 0;
    width: 8px;
  }

  .retour-haut::after {
    content: 'Retour en haut' / '';
    position: absolute;
    top: 50%;
    right: calc(100% + 8px);
    padding: 0.25rem 0.625rem;
    border-radius: var(--rayon-tres-petit);
    background: var(--bleu-fonce);
    /* Liseré clair : la bulle reste détachée sur les bandes bleu foncé */
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--couleur-surface) 35%, transparent);
    color: var(--couleur-sur-fonce);
    font-size: 0.875rem;
    font-weight: var(--graisse-moyenne);
    line-height: 1.4;
    white-space: nowrap;
    translate: 0 -50%;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--duree-courte) var(--courbe-standard),
      visibility 0s linear var(--duree-courte);
  }

  .retour-haut[data-visible]:hover:not([data-infobulle-fermee])::after,
  .retour-haut[data-visible]:focus-visible:not([data-infobulle-fermee])::after {
    visibility: visible;
    opacity: 1;
    transition:
      opacity var(--duree-courte) var(--courbe-standard) 80ms,
      visibility 0s linear 80ms;
  }

  .retour-haut[data-visible]:focus-visible:not([data-infobulle-fermee])::after {
    transition: none;
  }

  .retour-haut:focus-visible {
    outline: 3px solid var(--bleu-fonce);
    outline-offset: 3px;
    box-shadow: 0 0 0 3px var(--couleur-surface);
  }

  .retour-haut :global(svg) {
    display: block;
  }

  /* ≥ 900 px : onglet collé au bord droit, dans la marge de 64 px : il ne
     recouvre jamais le texte ni les cartes. */
  @media (min-width: 900px) {
    .retour-haut {
      --_ecart: 1.5rem;
      right: 0;
      /* En colonne au-dessus du rond de clavardage : l'infobulle, à gauche,
         s'ouvre au-dessus du rond et de son libellé, sans passer derrière.
         6,75 rem = libellé (2,5) + rond (3,5) + écart (0,75). */
      bottom: calc(var(--_base) + 6.75rem);
      width: 40px;
      height: 48px;
      border-radius: var(--rayon-petit) 0 0 var(--rayon-petit);
      translate: 0.75rem 0;
    }

    .retour-haut[data-visible] {
      translate: 0 0;
    }

    .retour-haut :global(svg) {
      width: 22px;
      height: 22px;
    }
  }

  @media (forced-colors: active) {
    .retour-haut {
      border: 2px solid ButtonText;
      background-color: ButtonFace;
      color: ButtonText;
    }
  }

  @media print {
    .retour-haut {
      display: none;
    }
  }
</style>
