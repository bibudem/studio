---
/*
 * Fil d'Ariane : le composant de harmonium (motif Breadcrumb de l'APG
 * WAI-ARIA), alimenté par l'arborescence du site. Harmonium produit le HTML
 * et sa feuille ; le site calcule les maillons (src/lib/contenu.ts).
 *
 * Le libellé d'une page dans une autre langue (frontmatter `lang`) porte son
 * lang ; `lang` sur le <nav> remet le fil en français sur une telle page.
 * Un groupe de pages (« À propos du site ») n'a pas de page à lui : son
 * maillon est du texte, sans lien.
 */
import FilArianeHarmonium from 'harmonium/astro/FilAriane.astro'
import { filAriane } from '@/lib/contenu'

interface Props {
  url: string
  lang?: string
}

const maillons = await filAriane(Astro.props.url)
---

<FilArianeHarmonium maillons={maillons} lang={Astro.props.lang} />

<style is:global>
  /* studio·bib : comme le menu de la section, texte foncé qui passe au jaune
     foncé au survol (le soulignement reste : un lien se reconnaît sans la
     couleur) */
  .bib-fil-ariane {
    --bib-fil-ariane-lien: var(--couleur-texte);
    --bib-fil-ariane-lien-survol: var(--couleur-lien-survol);
    --bib-fil-ariane-transition: color var(--duree-courte) var(--courbe-standard);
  }
</style>
