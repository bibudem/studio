---
/*
 * Pied de page : le composant de harmonium (paquet npm), alimenté par les
 * liens de src/data/navigation.ts. Harmonium produit le HTML et ses feuilles
 * (pied de page, licence, sceau) ; le site fournit le contenu.
 *
 * - « Besoin d'aide? » : liens à pictogramme, puis l'urgence, puis YouTube et
 *   Instagram. « Sites connexes » : une pastille de la couleur de chaque
 *   service devant son nom.
 * - Le sceau et le logo mènent au site des bibliothèques. Sur téléphone, le
 *   logo horizontal blanc remplace le sceau.
 * - Barre du bas : licence, liens légaux et « Paramètres des témoins », qui
 *   rouvre <bib-consentement> (ServicesInstitutionnels).
 *
 * Scripts de harmonium, facultatifs : volets repliables sous 900 px et bouton
 * des témoins (bib-pied-de-page), rotation du sceau au survol (bib-sceau).
 * Ils se rebranchent d'eux-mêmes à chaque page (astro:page-load).
 */
import PiedDePageHarmonium from 'harmonium/astro/PiedDePage.astro'
import scriptPied from 'harmonium/dist/bib-pied-de-page.min.js?url&no-inline'
import scriptSceau from 'harmonium/dist/bib-sceau.min.js?url&no-inline'
import { SirenIcon } from '@phosphor-icons/react/dist/ssr/Siren'
import { COLONNES_PIED, LIENS_QUEUE_PIED, RESEAUX_PIED, URGENCE } from '@/data/navigation'

const BIB = 'https://bib.umontreal.ca/'
---

<PiedDePageHarmonium
  colonnes={COLONNES_PIED}
  urgence={{ ...URGENCE, Icone: SirenIcon }}
  reseaux={RESEAUX_PIED}
  liensQueue={LIENS_QUEUE_PIED}
  accueil={BIB}
  logo={{ src: '/img/logo-bibliotheques-horizontal-blanc.svg' }}
  licence={{ href: `${BIB}conditions-utilisation/` }}
/>

<script is:inline type="module" src={scriptPied}></script>
<script is:inline type="module" src={scriptSceau}></script>
