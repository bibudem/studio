---
/*
 * Navigation de la section courante. Liste imbriquée de liens ; la page
 * courante porte aria-current="page" et la branche qui la contient est
 * ouverte.
 *
 * Deux variantes, rendues toutes les deux en HTML et basculées en CSS :
 * - « colonne » : colonne de gauche à partir de 1200 px (GabaritPage) ;
 * - « repliable » : sous 1200 px, un <details> « Dans cette section » placé
 *   sous le fil d'Ariane, fermé par défaut. Sans lui, la colonne disparaissait
 *   et les pages sœurs n'étaient plus accessibles que par le menu principal.
 * Une seule des deux est affichée à une largeur donnée : il n'y a donc jamais
 * deux repères <nav> du même nom dans l'arbre d'accessibilité.
 *
 * Le titre d'une page dans une autre langue porte son lang ; `lang` sur la
 * racine remet la navigation en français sur une telle page.
 *
 * `racine` remplace l'arbre de la section : groupe de pages sans section
 * (navigationDeGroupe) ou sommaire de la page. Une racine sans `url` a un
 * titre qui n'est pas un lien. Quand ce titre est aussi le libellé du
 * repliable (« Sur cette page »), on ne le répète pas dans le volet : le
 * libellé nomme alors la navigation.
 *
 * Un lien vers un autre site (Confidentialité, dans « À propos du site »)
 * porte la flèche oblique du menu principal.
 *
 * studio·bib : une catégorie sans
 * page est un volet <details> ; une page cachée du menu (guide, fiche de
 * logiciel) n'y figure pas, mais met son parent en évidence ; « recommandé »
 * ajoute une étoile nommée.
 *
 * studio·bib : navigation neutre (jetons --navigation-*) : trait gris, page en cours en
 * gras avec un trait bleu foncé ; le jaune est réservé aux actions.
 *
 * studio·bib : une page qui a des sous-pages porte une flèche (bouton) qui
 * ouvre ou ferme sa liste. Elle est ouverte quand elle contient la page
 * courante, fermée sinon. Sans JavaScript, la flèche est cachée et la liste
 * reste dépliée : aucune sous-page n'est perdue.
 */
import { ArrowUpRightIcon } from '@phosphor-icons/react/dist/ssr/ArrowUpRight'
import { StarIcon } from '@phosphor-icons/react/dist/ssr/Star'
import { navigationDeSection, type NoeudNavigation, type RacineNavigation } from '@/lib/contenu'
import { estExterne } from '@/data/navigation'
import { idUnique } from '@/lib/ids'

interface Props {
  section?: string
  racine?: RacineNavigation | null
  courante: string
  variante?: 'colonne' | 'repliable'
  /** Libellé du repliable */
  resume?: string
  lang?: string
  /** Id du titre, à donner quand la page a plusieurs navigations de même variante (sommaire) */
  idTitre?: string
}

const { section, courante, variante = 'colonne', resume = 'Dans cette section', lang } = Astro.props
const racine: RacineNavigation | null = Astro.props.racine ?? (section ? await navigationDeSection(section) : null)
const contient = (n: NoeudNavigation): boolean => n.url === courante || n.enfants.some(contient)
const repliable = variante === 'repliable'
const estSommaire = !section && racine?.sommaire === true
const titreDansResume = repliable && !racine?.url && racine?.titre === resume
const idTitre = Astro.props.idTitre ?? (repliable ? 'titre-navigation-section' : 'titre-navigation-secondaire')
const Enveloppe = repliable ? 'details' : Fragment
const attributsEnveloppe = repliable ? { class: 'section-repliable', lang } : {}
---

{
  racine && (
    <Enveloppe {...attributsEnveloppe}>
      {repliable && (
        <summary>
          <span id={titreDansResume ? idTitre : undefined}>{resume}</span>
          <span class="chevron" aria-hidden="true" />
        </summary>
      )}
      <nav class:list={['navigation-secondaire', { 'dans-repliable': repliable, 'est-sommaire': estSommaire }]} aria-labelledby={idTitre} lang={repliable ? undefined : lang}>
        {racine.url && !repliable && section ? (
          // studio·bib : la colonne ne répète pas le nom de la section (déjà dans le fil d'Ariane et le menu) ; elle se nomme comme le repliable
          <p id={idTitre} class="titre">
            Dans cette section
          </p>
        ) : racine.url ? (
          <a id={idTitre} class="titre" href={racine.url} lang={racine.lang} aria-current={racine.url === courante ? 'page' : undefined}>
            {racine.titre}
          </a>
        ) : (
          !titreDansResume && (
            <p id={idTitre} class="titre" lang={racine.lang}>
              {racine.titre}
            </p>
          )
        )}
        <ul>
          {racine.enfants.filter((n) => !n.cache).map(function rendre(n: NoeudNavigation) {
            const ouvert = contient(n)
            const visibles = n.enfants.filter((e) => !e.cache)
            // Page courante cachée du menu (guide, fiche de logiciel) : son parent est mis en évidence
            const parentCourant = n.enfants.some((e) => e.cache && contient(e))
            const libelle = (
              <>
                {n.titre}
                {n.recommande && <StarIcon size={14} weight="fill" class="recommande" aria-label="(recommandé)" role="img" />}
                {n.url && estExterne(n.url) && <ArrowUpRightIcon size={14} aria-hidden="true" className="externe" />}
              </>
            )
            if (!n.url) {
              // Catégorie sans page : un volet, ouvert s'il contient la page courante
              return (
                <li>
                  <details class="categorie" open={ouvert}>
                    <summary>{n.titre}<span class="chevron" aria-hidden="true" /></summary>
                    <ul>{visibles.map(rendre)}</ul>
                  </details>
                </li>
              )
            }
            const lien = (
              <a href={n.url} lang={n.lang} aria-current={n.url === courante ? 'page' : undefined} class:list={{ 'parent-courant': parentCourant }}>
                {libelle}
              </a>
            )
            if (!visibles.length) return <li>{lien}</li>
            const idSous = idUnique('sous-pages')
            return (
              <li>
                <div class="ligne">
                  {lien}
                  <button type="button" class="bascule" aria-expanded={ouvert ? 'true' : 'false'} aria-controls={idSous} aria-label={`Sous-pages de ${n.titre}`}>
                    <span class="chevron" aria-hidden="true" />
                  </button>
                </div>
                <ul id={idSous} class="sous-pages" data-ferme={ouvert ? undefined : ''}>{visibles.map(rendre)}</ul>
              </li>
            )
          })}
        </ul>
      </nav>
    </Enveloppe>
  )
}

<script>
  // Flèche d'une page à sous-pages : ouvre ou ferme sa liste
  document.addEventListener('click', (e) => {
    const bouton = (e.target as Element).closest<HTMLButtonElement>('.navigation-secondaire .bascule')
    if (!bouton) return
    const ouvrir = bouton.getAttribute('aria-expanded') !== 'true'
    bouton.setAttribute('aria-expanded', String(ouvrir))
    document.getElementById(bouton.getAttribute('aria-controls')!)?.toggleAttribute('data-ferme', !ouvrir)
  })
</script>

<style>
  .navigation-secondaire {
    font-size: 0.9375rem;
  }

  .titre {
    display: block;
    margin-block-start: 0;
    margin-block-end: var(--espace-element);
    color: var(--couleur-texte);
    font-size: 1.25rem;
    font-weight: var(--graisse-forte);
    text-decoration: none;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul ul {
    padding-inline-start: 1rem;
  }

  /* studio·bib : navigation neutre. Au survol, fond gris très pâle et trait plus foncé ; la
     page en cours est en gras, avec un trait bleu foncé de 4 px (repérable sans la couleur). */
  li a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-inline-start: 2px solid var(--navigation-filet);
    border-radius: 0 var(--rayon-tres-petit) var(--rayon-tres-petit) 0;
    color: var(--couleur-texte);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition:
      background-color var(--duree-courte-4) var(--courbe-standard),
      border-color var(--duree-courte-4) var(--courbe-standard);
  }

  li a :global(.externe) {
    margin-inline-start: 0.25em;
    vertical-align: -0.1em;
  }

  /* Page à sous-pages : le lien, puis la flèche qui ouvre sa liste */
  .ligne {
    display: flex;
    align-items: stretch;
  }

  .ligne > a {
    flex: 1;
    min-width: 0;
  }

  .bascule {
    display: none;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--couleur-texte);
    cursor: pointer;
  }

  .bascule:hover {
    background-color: var(--navigation-fond-survol);
  }

  /* La flèche n'existe qu'avec JavaScript, comme le repli des sous-pages */
  :global(:root[data-menu-js]) .bascule {
    display: flex;
  }

  :global(:root[data-menu-js]) .sous-pages[data-ferme] {
    display: none;
  }

  .bascule[aria-expanded='true'] .chevron {
    margin-block-start: 0.25em;
    transform: rotate(-135deg);
  }

  li a:hover {
    border-inline-start-color: var(--navigation-courant);
    background-color: var(--navigation-fond-survol);
  }

  /* studio·bib : aria-current="true" marque la section en cours dans « Sur cette page » */
  [aria-current='page'],
  [aria-current='true'],
  .parent-courant {
    font-weight: var(--graisse-forte);
  }

  /* « Sur cette page » : la section en cours a aussi le fond gris pâle */
  .est-sommaire li [aria-current='true'] {
    background-color: var(--navigation-fond-survol);
  }

  .recommande {
    margin-inline-start: 0.35em;
    vertical-align: -0.1em;
    /* Pictogramme porteur de sens : 3,45:1 sur le fond (WCAG 1.4.11) */
    color: var(--rouge-orange);
  }

  .categorie > summary {
    min-height: auto;
    padding: 0.5rem 0.75rem;
    border-inline-start: 2px solid var(--navigation-filet);
    font-weight: var(--graisse-normale);
  }

  .categorie > summary:hover {
    border-inline-start-color: var(--navigation-courant);
    background-color: var(--navigation-fond-survol);
  }

  li [aria-current='page'],
  li [aria-current='true'] {
    border-inline-start: 4px solid var(--navigation-courant);
  }

  /* ---- Variante repliable (< 1200 px) ---- */
  .section-repliable {
    margin-block-end: var(--espace-4);
    border: 1px solid var(--couleur-bordure);
    border-radius: var(--rayon-petit);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 48px;
    padding: 0.5rem 1rem;
    font-weight: var(--graisse-forte);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    flex-shrink: 0;
    width: 0.5em;
    height: 0.5em;
    margin-block-start: -0.25em;
    border-block-end: 2px solid currentColor;
    border-inline-end: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--duree-courte-4) var(--courbe-standard);
  }

  [open] > summary .chevron {
    margin-block-start: 0.25em;
    transform: rotate(-135deg);
  }

  .dans-repliable {
    padding: 0.5rem 1rem 1rem;
  }

  .dans-repliable .titre {
    font-size: 1.0625rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 1200px) {
    .section-repliable {
      display: none;
    }
  }
</style>
