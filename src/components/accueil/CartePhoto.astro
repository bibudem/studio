---
/*
 * Carte à photo de l'accueil : photo plein cadre sous un voile sombre (plus dense à gauche, là où
 * se lit le texte), titre, description et flèche jaune. Toute la carte est un lien ; la photo est
 * décorative (alt vide), le titre et la description suffisent.
 */
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { ArrowRightIcon } from '@phosphor-icons/react/dist/ssr/ArrowRight'

interface Props {
  titre: string
  description: string
  url: string
  image: ImageMetadata
}

const { titre, description, url, image } = Astro.props
---

<a class="carte-photo" href={url}>
  <Picture class="carte-photo-image" src={image} alt="" widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" />
  <span class="carte-photo-texte">
    <span class="carte-photo-titre">{titre}</span>
    <span class="carte-photo-description">{description}</span>
  </span>
  <span class="carte-photo-fleche" aria-hidden="true">
    <ArrowRightIcon size={24} weight="light" />
  </span>
</a>

<style>
  .carte-photo {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--espace-2);
    height: 100%;
    min-height: 13.75rem;
    box-sizing: border-box;
    padding: 1.25rem 1.25rem 1.35rem;
    overflow: hidden;
    border-radius: var(--rayon-carte);
    /* Texte blanc sur voile sombre, quel que soit le thème */
    color: #fff;
    text-decoration: none;
    transition: box-shadow var(--duree-courte-4) var(--courbe-standard);
  }

  /* <picture> sort du flux : vide, il prenait quand même sa place (et l'écart du flex) à gauche du texte */
  .carte-photo :global(picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .carte-photo :global(.carte-photo-image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Voile : plus dense à gauche, là où se lit le texte */
  .carte-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(112deg, rgb(9 9 10 / 0.9) 0%, rgb(30 30 32 / 0.65) 45%, rgb(6 6 7 / 0.25) 100%);
  }

  .carte-photo:hover {
    color: #fff;
  }

  .carte-photo-texte {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-inline-size: 80%;
  }

  .carte-photo-titre {
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    font-weight: var(--graisse-forte);
    line-height: 1.2;
  }

  .carte-photo-description {
    color: #f4f4f5;
    line-height: 1.5;
  }

  .carte-photo-fleche {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: var(--rayon-plein);
    background-color: var(--action-fond);
    color: var(--action-texte);
    transition:
      translate var(--duree-courte-4) var(--courbe-standard),
      background-color var(--duree-courte-4) var(--courbe-standard);
  }

  @media (hover: hover) and (pointer: fine) {
    .carte-photo:hover {
      box-shadow: var(--ombre-2);
    }

    .carte-photo:hover .carte-photo-fleche {
      translate: 3px 0;
      background-color: var(--action-fond-survol);
    }
  }

  .carte-photo:focus-visible .carte-photo-fleche {
    background-color: var(--action-fond-survol);
  }
</style>
