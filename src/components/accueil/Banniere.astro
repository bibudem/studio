---
/*
 * Bannière de l'accueil : photo sous un voile, logo
 * studio·bib en h1 et une phrase fixe qui dit ce que fait le service (studio·bib :
 * plus de slogan tiré au hasard, qui ne disait rien et changeait à chaque visite).
 * La photo est tirée au hasard dans le navigateur.
 *
 * - Pas de saut de mise en page : toutes les photos sont rendues, en fond
 *   (position absolue), la seule visible porte `actif`.
 * - Sans JavaScript (et avant le tirage) : la première photo. Le tirage est un petit script en ligne placé juste après la
 *   bannière : il s'exécute pendant l'analyse du HTML, avant le premier
 *   affichage dans la plupart des cas.
 * - studio·bib : une seule photo est montrée, la photo tirée, qui apparaît en
 *   fondu une fois chargée (pas de photo de remplacement qui saute à l'image
 *   suivante). Les photos sont en `loading="lazy"` : celles qui restent
 *   masquées (display: none) ne sont jamais téléchargées.
 * - Voile (studio·bib) : la photo reste claire ; seule la partie où se lisent le logo et
 *   la phrase blanche (à gauche, sous 900 px toute la largeur) est assombrie, à 62 % : la phrase
 *   garde au moins 5,5:1 même devant une zone blanche de la photo. Le voile s'estompe vers
 *   la droite, sans gris plein en bas. Ombre portée légère en renfort.
 */
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
  images: ImageMetadata[]
  /** Phrase fixe dans la bannière (facultative) */
  phrase?: string
  /** Texte de remplacement du logo (contenu du h1) */
  nom: string
}

const { images, phrase, nom } = Astro.props
---

<div class="conteneur">
  <section class="banniere" aria-labelledby="titre-accueil">
    <div class="photos" data-tirage aria-hidden="true">
      {
        images.map((image, i) => (
          <Picture
            src={image}
            alt=""
            widths={[640, 960, 1440, 1920]}
            sizes="(width >= 1536px) 1408px, 100vw"
            formats={['avif', 'webp']}
            loading="lazy"
            class:list={['photo', { actif: i === 0 }]}
            data-element
          />
        ))
      }
    </div>
    <div class="contenu">
      <h1 id="titre-accueil" class="titre">
        <img class="logo" src="/img/logo-studiobib.svg" alt={nom} width="328" height="328" />
      </h1>
      {phrase && <p class="phrase">{phrase}</p>}
    </div>
    {/* studio·bib : la recherche du site, dans la bannière (passée en slot par l'accueil) */}
    <div class="recherche">
      <slot />
    </div>
  </section>
</div>

<script is:inline>
  // Tirage de la photo (voir l'en-tête du composant). Une seule photo est affichée : la photo
  // tirée, qui apparaît en fondu une fois chargée (jamais une autre photo avant elle).
  document.querySelectorAll('.banniere [data-tirage]').forEach((groupe) => {
    const elements = groupe.querySelectorAll('[data-element]')
    const choix = Math.floor(Math.random() * elements.length)
    const photo = elements[choix]
    if (!photo) return
    elements.forEach((el, i) => el.classList.toggle('actif', i === choix))
    // La photo tirée est la plus grande image du premier écran : chargée tout de suite, en priorité
    photo.loading = 'eager'
    photo.fetchPriority = 'high'
    if (photo.complete && photo.naturalWidth) return
    photo.classList.add('attente')
    const montrer = () => photo.classList.remove('attente')
    photo.addEventListener('load', montrer, { once: true })
    photo.addEventListener('error', montrer, { once: true })
  })
</script>

<style>
  .banniere {
    position: relative;
    /* Au-dessus du contenu qui suit : les suggestions de la recherche passent devant les tâches */
    z-index: 1;
    isolation: isolate;
    /* Pas d'overflow: hidden ici : les suggestions de la recherche débordent sous la bannière.
       Ce sont les photos qui sont rognées, à l'arrondi de la bannière. */
    /* studio·bib : logo en bas à droite ; la bannière lui réserve sa place sous la recherche */
    --_logo: 96px;
    --_logo-marge: var(--espace-2);

    /* La recherche dans le bas de la bannière */
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--espace-3);
    min-height: 12rem;
    /* Sous 900 px, la recherche passe au-dessus du logo, qui a sa place réservée en bas */
    padding: var(--espace-6) var(--espace-2) calc(var(--_logo) + 2 * var(--_logo-marge));
    border-radius: 0 0 var(--rayon-petit) var(--rayon-petit);
    background-color: var(--gris-700);
    color: var(--couleur-sur-fonce);
  }

  @media (width < 900px) {
    /* La bannière touche les bords de l'écran */
    .conteneur {
      padding-inline: 0;
    }

    .banniere {
      border-radius: 0;
    }
  }

  @media (min-width: 900px) {
    /* Même hauteur que le héros de la Boîte à outils (19 rem), contenu centré verticalement */
    /* Assez de largeur pour que la recherche centrée et le logo ne se touchent pas : la
       recherche descend près du bas, sans place réservée pour le logo */
    .banniere {
      --_logo: clamp(130px, 14vw, 200px);
      --_logo-marge: var(--espace-3);

      min-height: 19rem;
      padding: var(--espace-4) var(--espace-6) var(--espace-6);
    }
  }

  .photos {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    border-radius: inherit;
  }

  .photos::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Petit écran : le texte occupe toute la largeur, voile uniforme */
    background: color-mix(in srgb, var(--couleur-voile) 38%, transparent);
  }

  @media (min-width: 900px) {
    .photos::after {
      background: linear-gradient(
        to right,
        color-mix(in srgb, var(--couleur-voile) 38%, transparent) 0%,
        color-mix(in srgb, var(--couleur-voile) 38%, transparent) 55%,
        color-mix(in srgb, var(--couleur-voile) 5%, transparent) 100%
      );
    }
  }

  .photo {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--duree-moyenne-2) var(--courbe-standard);
  }

  /* Photo tirée pas encore chargée : invisible, puis fondu (le fond de la bannière reste) */
  .photo.attente {
    opacity: 0;
  }

  .photo.actif {
    display: block;
  }

  /* Le logo est placé à part ; le reste du contenu s'empile avec la recherche */
  .contenu {
    display: contents;
  }

  .recherche {
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }

  .recherche:empty {
    display: none;
  }

  /* Le h1 (logo) reste premier dans le code ; il est placé en bas à droite de la bannière */
  .titre {
    position: absolute;
    right: var(--_logo-marge);
    bottom: var(--_logo-marge);
    margin: 0;
    line-height: 0;
  }

  .logo {
    width: auto;
    height: var(--_logo);
  }

  .phrase {
    flex: 1;
    min-width: 0;
    max-width: 32ch;
    margin: 0;
    color: var(--couleur-sur-fonce);
    text-shadow: 0 1px 10px color-mix(in srgb, var(--couleur-voile) 45%, transparent);
    font-size: 1.0625rem;
    font-weight: var(--graisse-moyenne);
    line-height: 1.25;
    text-wrap: balance;
  }

  @media (min-width: 900px) {
    .phrase {
      font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    }
  }

  @media (forced-colors: active) {
    .phrase {
      color: CanvasText;
    }
  }
</style>
