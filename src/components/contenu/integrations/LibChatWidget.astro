---
/*
 * Fenêtre de clavardage LibChat (UneQuestion) intégrée dans la page : le
 * composant Intégration de harmonium (paquet npm), variante clavardage.
 *
 * Directive `::clavardage{hash=…}` : le hash par défaut est celui de ce
 * widget intégré. Harmonium réserve la hauteur de la fenêtre (402 px) dès le
 * HTML, affiche « Chargement du clavardage… », puis annonce un échec dans la
 * page (role="status") si LibChat ne répond pas. bib-integration.min.js
 * charge le script de LibChat et se rebranche de lui-même à chaque page
 * (astro:page-load).
 */
import Integration from 'harmonium/astro/Integration.astro'
import scriptIntegration from 'harmonium/dist/bib-integration.min.js?url&no-inline'

interface Props {
  hash?: string
  class?: string
  style?: string
}

const { hash = '9ee6ed73a6fb1854335aacfa8a7497ef4acaff4303c125783909dacc7b3200b9', class: classe, style } = Astro.props
---

<Integration clavardage={hash} class={classe} style={style} />
<script is:inline type="module" src={scriptIntegration}></script>
