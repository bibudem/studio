---
/*
 * Lien du contenu.
 *
 * Toujours un <a> ordinaire. On garde
 * les props du contenu (`to`, `Icon`, `iconProps`) et on corrige :
 * - un lien vers un PDF ou qui ouvre un nouvel onglet l'annonce en texte
 *   masqué ; `target="_blank"` reçoit `rel="noopener"` ;
 * - un lien sans icône dans un paragraphe se distingue autrement que par la
 *   couleur (WCAG 1.4.1) : le bleu principal n'a que 2,5:1 contre le texte, on
 *   le souligne donc. Un lien avec icône garde son apparence.
 * - studio·bib : un lien du contenu vers un autre site (hors de la famille
 *   Bibliothèques) porte la flèche oblique ↗ des boutons et des cartes,
 *   et l'annonce « lien externe » aux lecteurs d'écran. Pas de flèche
 *   pour un PDF (son icône vient du CSS global), un courriel ou un téléphone.
 */
import { ArrowRightIcon } from '@phosphor-icons/react/dist/ssr/ArrowRight'
import { ArrowUpRightIcon } from '@phosphor-icons/react/dist/ssr/ArrowUpRight'
import { analyserLien, annonceLien, versAilleurs } from '@/lib/liens'
import { classes, fusionnerStyles } from '@/lib/styles'

interface Props {
  to?: string
  /** Accepté en repli de `to` */
  href?: string
  /** true = flèche ; sinon un composant d'icône Phosphor */
  Icon?: boolean | any
  iconProps?: Record<string, unknown>
  target?: string
  rel?: string
  class?: string
  className?: string
  style?: string | Record<string, string | number>
  [attribut: string]: unknown
}

const { to, href, Icon, iconProps, target, rel, class: classe, className, style, ...reste } = Astro.props
const adresse = to ?? href ?? '#'
const analyse = analyserLien(adresse)
const { pdf } = analyse
const nouvelOnglet = target === '_blank'
// Règle commune aux liens, boutons et cartes (src/lib/liens.ts)
const externe = versAilleurs(analyse, nouvelOnglet)
const relFinal = nouvelOnglet ? [...new Set([...(rel ?? '').split(/\s+/).filter(Boolean), 'noopener'])].join(' ') : rel
const annonce = annonceLien({ pdf, nouvelOnglet }) || (externe ? ' (lien externe)' : '')
// Les icônes Phosphor sont des objets forwardRef, pas des fonctions
const Icone = Icon === true ? ArrowRightIcon : Icon ? Icon : null
---

<a href={adresse} target={target} rel={relFinal} class:list={['lien', { 'avec-icone': Icone }, classes(classe, className)]} style={fusionnerStyles(style)} {...reste}
  ><slot />{annonce && <span class="visuellement-masque">{annonce}</span>}{
    Icone && <Icone size="1.125rem" color="currentColor" {...iconProps} aria-hidden="true" focusable="false" />
  }{!Icone && externe && <ArrowUpRightIcon size="0.85em" weight="bold" aria-hidden="true" focusable="false" className="icone-externe" />}</a
>

<style>
  .lien {
    color: var(--couleur-lien);
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-offset: 0.15em;
  }

  .lien:hover {
    color: var(--couleur-lien-survol);
    text-decoration-thickness: 2px;
  }

  /* Flèche d'un lien vers un autre site : collée au dernier mot */
  .lien :global(.icone-externe) {
    margin-inline-start: 0.2em;
    vertical-align: -0.05em;
  }

  .avec-icone {
    display: inline-flex;
    align-items: center;
    gap: 0.375em;
    text-decoration: none;
  }

  .avec-icone:hover {
    text-decoration: underline;
  }

  .avec-icone :global(svg) {
    flex-shrink: 0;
  }
</style>
