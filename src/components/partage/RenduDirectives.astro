---
/*
 * Rendu d'une page Markdown (.md) : remplace les marqueurs posés par
 * src/plugins/directives.mjs par les composants du MDX, pour que les pages de
 * texte aient le même balisage et les mêmes styles que les pages MDX.
 *
 * Usage : <RenduDirectives><Content /></RenduDirectives>. Le contenu est
 * d'abord rendu en HTML, puis découpé en arbre (lireMarqueurs). Chaque
 * directive est rendue par son composant, et ses enfants par ce même
 * composant (Astro.self).
 *
 * Les images locales du Markdown arrivent aussi en marqueurs : on les rend
 * avec <Picture> (avif et webp, plusieurs largeurs), comme le MDX, au lieu de
 * l'unique taille qu'Astro produit pour une image Markdown.
 */
import type { ImageMetadata } from 'astro'
import { Picture, getImage } from 'astro:assets'
import Modalites from '@/components/contenu/modalites/Modalites.astro'
import Modalite from '@/components/contenu/modalites/Modalite.astro'
import CommandesCarrousel from '@/components/studio/CommandesCarrousel.astro'
import Alerte from '@/components/contenu/primitives/Alerte.astro'
import TitreAlerte from '@/components/contenu/primitives/TitreAlerte.astro'
import Citation from '@/components/contenu/primitives/Citation.astro'
import Bouton from '@/components/contenu/primitives/Bouton.astro'
import Lien from '@/components/contenu/primitives/Lien.astro'
import Grille from '@/components/contenu/primitives/Grille.astro'
import Separateur from '@/components/contenu/primitives/Separateur.astro'
import Typographie from '@/components/contenu/primitives/Typographie.astro'
import IconeCarree from '@/components/contenu/cartes/IconeCarree.astro'
import Surface from '@/components/contenu/primitives/Surface.astro'
import TableauConteneur from '@/components/contenu/primitives/TableauConteneur.astro'
import Tableau from '@/components/contenu/primitives/Tableau.astro'
import TableauEntete from '@/components/contenu/primitives/TableauEntete.astro'
import TableauCorps from '@/components/contenu/primitives/TableauCorps.astro'
import TableauLigne from '@/components/contenu/primitives/TableauLigne.astro'
import TableauCellule from '@/components/contenu/primitives/TableauCellule.astro'
import Section from '@/components/contenu/mise-en-page/Section.astro'
import HeroImage from '@/components/contenu/mise-en-page/HeroImage.astro'
import ListeRiche from '@/components/contenu/mise-en-page/ListeRiche.astro'
import ListeRicheElementLien from '@/components/contenu/mise-en-page/ListeRicheElementLien.astro'
import Chiffres from '@/components/contenu/mise-en-page/Chiffres.astro'
import CarteIcone from '@/components/contenu/cartes/CarteIcone.astro'
import CarteImage from '@/components/contenu/cartes/CarteImage.astro'
import AccordeonGroupe from '@/components/contenu/accordeons/AccordeonGroupe.astro'
import Accordeon from '@/components/contenu/accordeons/Accordeon.astro'
import AccordeonResume from '@/components/contenu/accordeons/AccordeonResume.astro'
import AccordeonDetails from '@/components/contenu/accordeons/AccordeonDetails.astro'
import RenduStudio from '@/components/studio/RenduStudio.astro'
import { composantIcone } from '@/lib/icones'
import { couleurPalette } from '@/lib/couleurs'
import { contientMarqueurs, lireMarqueurs } from '@/plugins/marqueurs-directives.mjs'

type Attributs = Record<string, any>
type Directive = { nom: string; attributs: Attributs; enfants: Noeud[] }
type Noeud = string | Directive

interface Props {
  /** Usage interne (récursion) ; sinon, le contenu vient du slot */
  noeuds?: Noeud[]
}

let noeuds = Astro.props.noeuds
let html = ''
if (!noeuds) {
  html = Astro.slots.has('default') ? await Astro.slots.render('default') : ''
  noeuds = contientMarqueurs(html) ? (lireMarqueurs(html) as Noeud[]) : undefined
}

const estDirective = (noeud: Noeud): noeud is Directive => typeof noeud !== 'string'
const directives = (liste: Noeud[]) => liste.filter(estDirective)

// Les boutons qui se suivent forment un groupe : côte à côte, avec un espace
// sous le groupe avant le paragraphe suivant ; centré si l'un d'eux le demande
function grouperBoutons(liste: Noeud[]) {
  const resultat: Noeud[] = []
  for (const noeud of liste) {
    const groupe = [...resultat].reverse().find((n) => typeof n !== 'string' || n.trim())
    if (estDirective(noeud) && noeud.nom === 'bouton') {
      if (groupe && estDirective(groupe) && groupe.nom === 'boutons') {
        while (resultat.at(-1) !== groupe) resultat.pop()
        groupe.enfants.push(noeud)
        if (noeud.attributs.alignement === 'centre') groupe.attributs.centre = true
      } else {
        resultat.push({ nom: 'boutons', attributs: { centre: noeud.attributs.alignement === 'centre' }, enfants: [noeud] })
      }
    } else {
      resultat.push(noeud)
    }
  }
  return resultat
}
if (noeuds) noeuds = grouperBoutons(noeuds)

// Images du contenu, chargées à la demande. Le plugin a déjà vérifié que le
// fichier existe et donne son chemin depuis la racine du projet. Sans les
// bannières ni les photos du personnel : lib/bannieres.ts et
// mdx/personnel/photos.ts les importent déjà toutes, et Vite avertissait à
// chaque build d'un import à la demande sans effet (INEFFECTIVE_DYNAMIC_IMPORT).
const IMAGES = import.meta.glob<{ default: ImageMetadata }>([
  '/src/content/**/*.{jpg,jpeg,png,webp,avif,gif,svg,JPG,JPEG,PNG,WEBP}',
  '!/src/content/pages/images/super-heroes/**',
  '!/src/content/personnel/photos/**',
])

async function chargerImage(src: string) {
  const charger = IMAGES[src]
  if (!charger) throw new Error(`RenduDirectives : image introuvable (${src}).`)
  return (await charger()).default
}

// Icônes et images de ce niveau (et des cartes, rendues ici), chargées avant le rendu
const ressources = new Map<Noeud, any>()
// Version agrandie (clic sur une photo) : au plus 2000 px, en WebP. Le script de
// AgrandirImages décide au chargement si l'image est assez réduite pour valoir l'agrandissement.
const LARGEUR_AGRANDIE = 2000
const agrandies = new Map<Noeud, { src: string; largeur: number }>()
async function preparerAgrandie(noeud: Noeud, image: ImageMetadata) {
  if (image.format === 'svg' || image.format === 'gif') return
  const largeur = Math.min(image.width, LARGEUR_AGRANDIE)
  agrandies.set(noeud, { src: (await getImage({ src: image, format: 'webp', width: largeur })).src, largeur })
}
for (const noeud of directives(noeuds ?? [])) {
  const a = noeud.attributs
  if (noeud.nom === 'modalite') ressources.set(noeud, await composantIcone(a.icone))
  else if (noeud.nom === 'image') {
    const image = await chargerImage(a.src)
    ressources.set(noeud, image)
    if (!a.enLigne) await preparerAgrandie(noeud, image)
  }
  else if (noeud.nom === 'image-texte') ressources.set(noeud, await chargerImage(a.image))
  else if (noeud.nom === 'figure' || noeud.nom === 'logo') {
    const image = await chargerImage(a.src)
    ressources.set(noeud, image)
    if (noeud.nom === 'figure') await preparerAgrandie(noeud, image)
  }
  else if (noeud.nom === 'icone-texte' || (noeud.nom === 'encadre' && a.icone)) ressources.set(noeud, await composantIcone(a.icone))
  else if (noeud.nom === 'cartes') {
    for (const carte of directives(noeud.enfants)) {
      ressources.set(carte, carte.attributs.image ? await chargerImage(carte.attributs.image) : carte.attributs.icone ? await composantIcone(carte.attributs.icone) : undefined)
    }
  }
}

// Les boutons qui terminent un bloc image-texte vont dans son pied : sous
// l'image sur un téléphone, comme le footer de HeroImage dans le MDX
function separerBoutons(enfants: Noeud[]) {
  const contenu = [...enfants]
  const boutons: Noeud[] = []
  while (contenu.length) {
    const dernier = contenu.at(-1)!
    if (typeof dernier === 'string' && !dernier.trim()) contenu.pop()
    else if (estDirective(dernier) && dernier.nom === 'bouton') boutons.unshift(contenu.pop()!)
    else break
  }
  return { contenu, boutons }
}

// Une image du texte s'affiche au plus à sa taille réelle, et au plus sur la
// largeur d'une Section (1536 px moins ses marges de 64 px)
const LARGEUR_MAX = 1408
function largeurs(image: ImageMetadata) {
  const largeur = Math.min(image.width, LARGEUR_MAX)
  return { widths: [600, 900, 1200].filter((l) => l < largeur).concat(largeur), sizes: `(min-width: ${largeur}px) ${largeur}px, 100vw` }
}
// Une image vectorielle ou animée se sert telle quelle
const sansConversion = (image: ImageMetadata) => image.format === 'svg' || image.format === 'gif'

// Petite image d'image-texte et logos : affichées sur une hauteur fixe, en 1x et 2x
function largeursHauteur(image: ImageMetadata, hauteur: number) {
  const largeur = Math.round((image.width / image.height) * hauteur)
  const widths = [largeur, largeur * 2].filter((l) => l <= image.width)
  return { widths: widths.length ? widths : [image.width], sizes: `${largeur}px` }
}
const SEVERITES: Record<string, string> = { info: 'info', succes: 'success', attention: 'warning', erreur: 'error' }
// Largeur minimale des tableaux (650 px) : sur un téléphone, le tableau défile au lieu de s'écraser. Un
// tableau de deux colonnes tient dans l'écran : il n'en a pas, pour ne pas
// défiler à l'horizontale (libellé à gauche, valeur à droite).
const STYLE_TABLEAU = { minWidth: '650px' }
const COLONNES_SANS_MINIMUM = 2

// Nombre de colonnes d'un tableau : cellules de sa première rangée
function colonnes(enfants: Noeud[]): number {
  for (const noeud of directives(enfants)) {
    if (noeud.nom === 'rangee') return directives(noeud.enfants).filter((n) => n.nom === 'cellule').length
    const trouve = colonnes(noeud.enfants)
    if (trouve) return trouve
  }
  return 0
}
// Grille des cartes à icône : 1 puis 2 colonnes
const TAILLE_CARTE = { xs: 12, sm: 6 }
---

{/* Une seule expression : un blanc entre deux s'ajouterait au rendu (dans un lien) */}{
  !noeuds ? <Fragment set:html={html} /> : noeuds.map((noeud) => {
    if (typeof noeud === 'string') return <Fragment set:html={noeud} />
    const { nom, attributs: a, enfants } = noeud
    switch (nom) {
      case 'modalites':
        return (
          <Modalites>
            <Astro.self noeuds={enfants} />
          </Modalites>
        )
      case 'modalite':
        return (
          <Modalite Icon={ressources.get(noeud)} taille={a.taille} couleur={a.couleur}>
            <Astro.self noeuds={enfants} />
          </Modalite>
        )
      case 'alerte':
        return (
          <Alerte severity={SEVERITES[a.type ?? 'info'] as 'info'}>
            {a.titre && <TitreAlerte>{a.titre}</TitreAlerte>}
            <Astro.self noeuds={enfants} />
          </Alerte>
        )
      case 'boutons':
        return (
          <div class:list={['boutons', { centre: a.centre }]}>
            {directives(noeud.enfants).map((bouton) => (
              <Bouton href={bouton.attributs.lien} primary={bouton.attributs.type !== 'secondaire'} secondary={bouton.attributs.type === 'secondaire'}>
                <Astro.self noeuds={bouton.enfants} />
              </Bouton>
            ))}
          </div>
        )
      case 'a':
        // Sur une ligne : un blanc autour du slot s'afficherait dans le lien
        return <Lien to={a.href} title={a.title} target={a.target} rel={a.rel}><Astro.self noeuds={enfants} /></Lien>
      case 'section':
        return (
          <Section bg={a.fond} id={a.id}>
            <Astro.self noeuds={enfants} />
          </Section>
        )
      case 'image': {
        const image = ressources.get(noeud) as ImageMetadata
        const agrandie = agrandies.get(noeud)
        const attrsAgrandie = agrandie ? { 'data-agrandir': agrandie.src, 'data-largeur-agrandie': agrandie.largeur } : {}
        return sansConversion(image) ? (
          <img class:list={{ 'icone-en-ligne': a.enLigne }} src={image.src} width={image.width} height={image.height} alt={a.alt} loading="lazy" decoding="async" />
        ) : (
          <Picture class:list={{ 'icone-en-ligne': a.enLigne }} {...attrsAgrandie} src={image} alt={a.alt} formats={['avif', 'webp']} fallbackFormat="webp" {...largeurs(image)} loading="lazy" decoding="async" />
        )
      }
      case 'cartes': {
        const cartes = directives(enfants)
        if (a.forme === 'image') {
          return (
            <div class="cartes-carrousel" data-cartes-carrousel>
              <div class="cartes-images" data-revelation="groupe" data-piste>
                {cartes.map((carte) => (
                  <CarteImage title={carte.attributs.titre} Image={ressources.get(carte)} href={carte.attributs.lien} moreText={carte.attributs.appel} niveauTitre={a.niveau} />
                ))}
              </div>
              {/* studio·bib, mobile : flèches et indicateur sous la rangée (le carrousel n'existe que sous 600 px) */}
              <div class="cartes-commandes">
                <CommandesCarrousel total={cartes.length} />
              </div>
            </div>
          )
        }
        return (
          <div class="cartes-icones">
            <Grille container spacing="var(--espace-grille)" alignItems="stretch" data-revelation="groupe">
              {cartes.map((carte) => (
                <Grille size={TAILLE_CARTE}>
                  {/* studio·bib : toutes les cartes à icône sont des CarteIcone compactes (jaune pâle), avec ou sans texte d'appel */}
                  <CarteIcone title={carte.attributs.titre} Icon={ressources.get(carte)} href={carte.attributs.lien} moreText={carte.attributs.appel} etiquette={carte.attributs.etiquette} color={a.couleur} fullWidth />
                </Grille>
              ))}
            </Grille>
          </div>
        )
      }
      case 'liens':
        return (
          <ListeRiche>
            {directives(enfants).map((lien) => (
              <ListeRicheElementLien title={lien.attributs.titre} description={lien.attributs.description} href={lien.attributs.lien} niveauTitre={a.niveau} />
            ))}
          </ListeRiche>
        )
      case 'image-texte': {
        if (a.taille === 'petite') {
          const image = ressources.get(noeud) as ImageMetadata
          return (
            <div class:list={['image-texte-petite', a.position === 'gauche' ? 'image-gauche' : 'image-droite']}>
              <div class="petite-texte">
                <Astro.self noeuds={enfants} />
              </div>
              <div class="petite-image">
                {sansConversion(image) ? (
                  <img src={image.src} width={image.width} height={image.height} alt={a.alt} loading="lazy" decoding="async" />
                ) : (
                  <Picture src={image} alt={a.alt} formats={['avif', 'webp']} fallbackFormat="webp" {...largeursHauteur(image, 200)} loading="lazy" decoding="async" />
                )}
              </div>
            </div>
          )
        }
        const { contenu, boutons } = separerBoutons(enfants)
        return (
          <HeroImage Image={ressources.get(noeud)} align={a.position === 'gauche' ? 'right' : 'left'} class="image-texte" compact>
            <Astro.self noeuds={contenu} />
            {boutons.length > 0 && (
              <Fragment slot="footer">
                <Astro.self noeuds={boutons} />
              </Fragment>
            )}
          </HeroImage>
        )
      }
      case 'galerie':
        return (
          <div class="galerie">
            <Astro.self noeuds={enfants} />
          </div>
        )
      case 'figure': {
        const image = ressources.get(noeud) as ImageMetadata
        const agrandie = agrandies.get(noeud)
        const attrsAgrandie = agrandie ? { 'data-agrandir': agrandie.src, 'data-largeur-agrandie': agrandie.largeur } : {}
        return (
          <figure class="galerie-figure">
            {/* studio·bib : un SVG (diagramme) se sert tel quel, comme dans les autres cas */}
            {sansConversion(image) ? (
              <img class="diagramme" src={image.src} width={image.width} height={image.height} alt={a.alt} loading="lazy" decoding="async" />
            ) : (
              <Picture {...attrsAgrandie} src={image} alt={a.alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 800].filter((l) => l < image.width).concat(Math.min(image.width, 800))} sizes="(min-width: 900px) 30vw, 100vw" loading="lazy" decoding="async" />
            )}
            <Typographie variant="body2" component="figcaption" class="galerie-legende">
              <Astro.self noeuds={enfants} />
            </Typographie>
          </figure>
        )
      }
      case 'logos':
        return (
          <div class="logos">
            <Astro.self noeuds={enfants} />
          </div>
        )
      case 'logo': {
        const image = ressources.get(noeud) as ImageMetadata
        const visuel = <Picture src={image} alt={a.alt} formats={['avif', 'webp']} fallbackFormat="webp" {...largeursHauteur(image, 200)} loading="lazy" decoding="async" />
        return <div class="logo">{a.lien ? <Lien to={a.lien}>{visuel}</Lien> : visuel}</div>
      }
      case 'icone-texte': {
        const Icone = ressources.get(noeud)
        return (
          <div class="icone-texte">
            <div class="icone-texte-texte">
              <Astro.self noeuds={enfants} />
            </div>
            <IconeCarree color={a.fond} style={{ maxWidth: '100%' }}>
              <Icone aria-hidden="true" focusable="false" />
            </IconeCarree>
          </div>
        )
      }
      case 'chiffres':
        return <Chiffres forme={a.forme} groupes={a.groupes} />
      case 'encadres':
        return (
          <div class="encadres" style={{ '--_fond-encadre': couleurPalette(a.fond) }}>
            <Astro.self noeuds={enfants} />
          </div>
        )
      case 'encadre': {
        const Icone = ressources.get(noeud)
        return (
          <div class="encadre surface-claire">
            {Icone && (
              <span class="encadre-icone" aria-hidden="true">
                <Icone size={a.taille ?? 50} color={a.couleur ?? 'var(--rouge-orange)'} aria-hidden="true" focusable="false" />
              </span>
            )}
            <Astro.self noeuds={enfants} />
          </div>
        )
      }
      case 'separateur':
        return <Separateur />
      case 'citation':
        return (
          <Citation source={a.source}>
            <Astro.self noeuds={enfants} />
          </Citation>
        )
      case 'accordeon':
        return (
          <AccordeonGroupe>
            <Astro.self noeuds={enfants} />
          </AccordeonGroupe>
        )
      case 'volet':
        return (
          <Accordeon id={a.id}>
            <AccordeonResume niveauTitre={a.niveau}>{a.titre}</AccordeonResume>
            <AccordeonDetails>
              <Astro.self noeuds={enfants} />
            </AccordeonDetails>
          </Accordeon>
        )
      case 'tableau':
        return (
          <TableauConteneur component={Surface}>
            <Tableau style={colonnes(enfants) > COLONNES_SANS_MINIMUM ? STYLE_TABLEAU : undefined} aria-label={a.titre}>
              <Astro.self noeuds={enfants} />
            </Tableau>
          </TableauConteneur>
        )
      case 'tete':
        return (
          <TableauEntete>
            <Astro.self noeuds={enfants} />
          </TableauEntete>
        )
      case 'corps':
        return (
          <TableauCorps>
            <Astro.self noeuds={enfants} />
          </TableauCorps>
        )
      case 'rangee':
        return (
          <TableauLigne>
            <Astro.self noeuds={enfants} />
          </TableauLigne>
        )
      case 'cellule':
        return (
          <TableauCellule align={a.align as 'left'}>
            <Astro.self noeuds={enfants} />
          </TableauCellule>
        )
      default:
        // studio·bib : directives propres au site (src/plugins/directives-studio.mjs)
        return (
          <RenduStudio nom={nom} attributs={a} enfants={enfants}>
            <Astro.self noeuds={enfants} />
          </RenduStudio>
        )
    }
  })
}

<script>
  // Carrousel mobile des cartes à photo : flèches, points et annonce (src/lib/commandes-carrousel.ts)
  import { brancherCommandes } from '@/lib/commandes-carrousel'

  for (const racine of document.querySelectorAll<HTMLElement>('[data-cartes-carrousel]')) brancherCommandes(racine)
</script>

<style>
  /* Groupe de ::bouton : la marge du haut vient de Button (1rem) */
  .boutons {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--espace-element);
    margin-block-end: var(--espace-element);
  }

  .boutons.centre {
    justify-content: center;
  }

  /* Grilles de cartes : mêmes écarts que les blocs de vitrine */
  .cartes-icones {
    margin-block: var(--espace-bloc);
  }

  /* studio·bib : les cartes d'une rangée ont la même hauteur (celle de la plus haute) */
  .cartes-icones :global(.carte) {
    height: 100%;
  }

  /* Image et texte (taille normale) : un bloc de la page, --espace-bloc
     au-dessus et au-dessous ; sur un téléphone, l'image est une vignette
     (HeroImage compact) */
  .image-texte {
    margin-block: var(--espace-bloc);
  }

  /* Petite image à côté du texte (taille=petite) : l'image garde sa petite
     taille, et le texte
     prend le reste. Empilés sous 900 px. */
  .image-texte-petite {
    display: flex;
    flex-direction: column;
    gap: var(--espace-grille);
    margin-block: var(--espace-bloc);
  }

  .image-texte-petite.image-gauche .petite-image {
    order: -1;
  }

  .petite-texte > :global(:first-child) {
    margin-top: 0;
  }

  .petite-texte > :global(:last-child) {
    margin-bottom: 0;
  }

  .petite-image :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: 11rem;
    object-fit: contain;
    object-position: left top;
    border-radius: var(--rayon-petit);
  }

  @media (min-width: 900px) {
    .image-texte-petite {
      display: grid;
      align-items: start;
      gap: var(--espace-grille);
    }

    .image-texte-petite.image-droite {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .image-texte-petite.image-gauche {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }

  /* Galerie : figures de 170 px au moins, côte à côte (fonds-livres-rares) */
  .galerie {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--espace-grille);
