---
/*
 * Directive `::horaire-soutien{bibliotheque=ss}` : l'horaire de la semaine
 * du soutien informatique, avec le composant Horaire de la semaine de
 * harmonium (paquet npm). bib-horaire-semaine.min.js lit l'API des horaires
 * (service « soutien-informatique » de la bibliothèque donnée), montre un
 * jour à la fois sur huit semaines, et se rebranche de lui-même à chaque page
 * (astro:page-load). Sans JavaScript ou si l'API ne répond pas, le texte de
 * repli reste.
 *
 * Le conteneur porte data-revelation : l'horaire apparaît au défilement
 * comme les autres blocs (src/lib/animations.ts).
 */
import HoraireSemaine from 'harmonium/astro/HoraireSemaine.astro'
import scriptHoraire from 'harmonium/dist/bib-horaire-semaine.min.js?url&no-inline'

interface Props {
  /** Code de la bibliothèque dans l'API horaires (ss = Lettres et sciences humaines) */
  bibliotheque: string
  [attribut: string]: unknown
}

const { bibliotheque } = Astro.props
---

<div data-revelation="unite">
  <HoraireSemaine bibliotheque={bibliotheque} service="soutien-informatique">
    Consultez les <a href="https://bib.umontreal.ca/horaires">heures d’ouverture des bibliothèques</a> ou écrivez-nous par clavardage.
  </HoraireSemaine>
</div>
<script is:inline type="module" src={scriptHoraire}></script>
