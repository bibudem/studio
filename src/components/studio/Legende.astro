---
/*
 * Légende d'icônes (guide de la salle anatomique) : une carte par icône, le
 * visuel à gauche, le nom et la description à droite ; les sous-menus
 * (liste imbriquée) s'affichent dans la carte, en tuiles plus petites.
 *
 * Le contenu reste dans le Markdown (directives-studio.mjs, « legende ») :
 *
 *   :::legende
 *   - ![Œil](./images/oeil.webp) **Menu de visibilité** Activer et désactiver…
 *     - ![Coche](./images/coche.webp) Afficher ou cacher…
 *   :::
 *
 * Le plugin a déjà posé les conteneurs (.legende-visuel, .legende-texte,
 * .legende-sous) : ce composant ne fait que la mise en page. La liste reste
 * une vraie liste (<ul>), imbriquée comme dans le Markdown.
 *
 * Les cartes simples vont deux par rangée, le visuel au-dessus du texte ; une
 * carte qui a des sous-menus prend toute la largeur, visuel à côté du texte.
 *
 * forme=panneau : un seul cadre, une rangée par icône séparée par un filet,
 * pour une longue série d'icônes simples (menu principal).
 */
interface Props {
  forme?: string
  [attribut: string]: unknown
}
const { forme } = Astro.props
---

<div class:list={['legende', { 'legende-panneau': forme === 'panneau' }]}>
  <slot />
</div>

<style>
  .legende {
    --taille-visuel: 5rem;
    --taille-visuel-min: 4rem;
    --taille-visuel-sous: 3rem;

    margin-block: var(--espace-3) var(--espace-4);
  }

  /* Listes : la structure reste annoncée (« liste, 11 éléments »), sans puces */
  .legende :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legende :global(li) {
    max-inline-size: none;
    margin: 0;
  }

  .legende :global(.legende-liste) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--espace-element);
  }

  /* Carte simple : le visuel au-dessus du texte (les cartes vont deux par
     rangée, le texte garde toute la largeur de la carte) */
  .legende :global(.legende-liste > li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--espace-element);
    align-content: start;
    padding: var(--espace-element);
    border: 1px solid var(--couleur-bordure);
    border-radius: var(--rayon-carte);
    background: var(--couleur-surface);
  }

  /* Carte à sous-menus : toute la largeur, visuel | texte, puis les sous-menus */
  .legende :global(.legende-liste > li:has(> .legende-sous)) {
    grid-column: 1 / -1;
    grid-template-columns: var(--taille-visuel) minmax(0, 1fr);
  }

  .legende-panneau {
    --taille-visuel: 4.25rem;
  }

  /* Panneau : les filets sont le fond du cadre, visible entre les rangées (gap de 1 px) */
  .legende-panneau :global(.legende-liste) {
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--couleur-bordure);
    border-radius: var(--rayon-carte);
    background: var(--couleur-bordure);
  }

  .legende-panneau :global(.legende-liste > li) {
    grid-template-columns: var(--taille-visuel) minmax(0, 1fr);
    border: 0;
    border-radius: 0;
  }

  /* Visuel : l'icône telle qu'à l'écran de la table, dans une tuile neutre */
  /* Largeur fixe, hauteur selon l'image : un bouton large ou une planche
     d'icônes (orientation) garde ses proportions et reste lisible */
  .legende :global(.legende-visuel) {
    display: grid;
    place-items: center;
    width: var(--taille-visuel);
    min-height: var(--taille-visuel-min, var(--taille-visuel));
    align-self: start;
    padding: 0.35rem;
    border-radius: var(--rayon-tres-petit);
    background: var(--couleur-fond-neutre);
    color: var(--couleur-texte);
  }

  .legende :global(.legende-visuel picture) {
    display: contents;
  }

  .legende :global(.legende-visuel img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    vertical-align: initial;
    border-radius: 4px;
  }

  .legende :global(.legende-visuel svg) {
    width: 60%;
    height: 60%;
  }

  .legende :global(.legende-texte) {
    align-self: center;
    color: var(--couleur-texte-secondaire);
    font-size: 0.95rem;
    line-height: 1.45;
    overflow-wrap: break-word;
  }

  /* Le nom, en gras au début, sur sa propre ligne */
  .legende :global(.legende-texte > strong:first-child) {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--couleur-texte);
    font-size: 1rem;
    line-height: 1.3;
  }

  /* Sous-menus : tuiles plus petites, sous la description */
  .legende :global(.legende-sous) {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.6rem;
  }

  .legende :global(.legende-sous > li) {
    display: grid;
    grid-template-columns: var(--taille-visuel-sous) minmax(0, 1fr);
    gap: 0.75rem;
    align-content: start;
    padding: 0.6rem;
    border-radius: var(--rayon-tres-petit);
    background: var(--couleur-fond-neutre);
  }

  .legende :global(.legende-sous .legende-visuel) {
    --taille-visuel-min: var(--taille-visuel-sous);

    width: var(--taille-visuel-sous);
    padding: 0.2rem;
    background: var(--couleur-surface);
  }

  /* Sous-menu qui a ses propres sous-menus (roue arc-en-ciel) : toute la largeur */
  .legende :global(.legende-sous > li:has(> .legende-sous)) {
    grid-column: 1 / -1;
  }

  .legende :global(.legende-sous .legende-sous) {
    padding-left: 0.75rem;
    border-left: 3px solid var(--couleur-bordure);
  }

  .legende :global(.legende-sous .legende-sous > li) {
    background: var(--couleur-surface);
  }

  .legende :global(.legende-sous .legende-sous .legende-visuel) {
    background: var(--couleur-fond-neutre);
  }

  @media (min-width: 600px) {
    .legende {
      --taille-visuel: 6.5rem;
    }

    .legende-panneau {
      --taille-visuel: 5.5rem;
    }

    .legende :global(.legende-liste > li) {
      gap: var(--espace-element) 1.25rem;
      padding: 1.25rem;
    }
  }

  @media (forced-colors: active) {
    .legende :global(.legende-sous > li),
    .legende :global(.legende-visuel) {
      border: 1px solid CanvasText;
    }
  }
</style>
