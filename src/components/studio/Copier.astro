---
/*
 * Directive `:copier[texte]` : le composant de harmonium (paquet npm). Le
 * texte à copier en code, et un bouton « Copier » que bib-copier.min.js
 * montre seulement si le presse-papiers est disponible ; la copie est
 * confirmée à l'écran et annoncée (role="status"). Le script se rebranche de
 * lui-même à chaque page (astro:page-load).
 */
import CopierHarmonium from 'harmonium/astro/Copier.astro'
import scriptCopier from 'harmonium/dist/bib-copier.min.js?url&no-inline'

interface Props {
  texte: string
}

const { texte } = Astro.props
---

<CopierHarmonium texte={texte} /><script is:inline type="module" src={scriptCopier}></script>
