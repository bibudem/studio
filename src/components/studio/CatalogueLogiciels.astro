---
/*
 * Catalogue des logiciels : la Liste filtrable de harmonium (paquet npm), une
 * Fiche filtrable par logiciel et ses Étiquettes (Pastilles).
 *
 * - Le CSV (public/data/logiciels.csv) est lu au build : tout le catalogue
 *   est dans le HTML, lisible et indexable sans JavaScript.
 * - Amélioration progressive : bib-liste-filtrable.min.js montre la
 *   recherche et le filtre par catégorie, masque les fiches qui ne
 *   correspondent pas et annonce le nombre de résultats (role="status"). La
 *   recherche ignore la casse et les accents. Le script se rebranche de
 *   lui-même à chaque page (astro:page-load).
 * - Étiquettes de chaque fiche : « Logiciel libre » (texte, jaune), « Accès à
 *   distance » et « Guides » (liens, rose et bleu), puis les bibliothèques où
 *   l'utiliser (variante lieu, lien vers leur page s'il est connu).
 */
import ListeFiltrable from 'harmonium/astro/ListeFiltrable.astro'
import FicheFiltrable from 'harmonium/astro/FicheFiltrable.astro'
import Pastilles from 'harmonium/astro/Pastilles.astro'
import scriptListe from 'harmonium/dist/bib-liste-filtrable.min.js?url&no-inline'
import { lireCsvObjets } from '@/lib/csv'
import { SITE } from '@/data/site'
import { LIENS_BIBLIOTHEQUES } from '@/data/logiciels'

interface Props {
  [attribut: string]: unknown
}

const logiciels = lireCsvObjets('/data/logiciels.csv').filter((l) => l.nom)
const categories = [...new Set(logiciels.map((l) => l.categorie).filter(Boolean))]
const externe = (lien: string) => /^https?:\/\//.test(lien)

/** Une étiquette, telle que l'attend Pastilles de harmonium */
type Pastille = { libelle: string; lien?: string; variante: 'jaune' | 'rose' | 'bleu' | 'lieu'; icone: 'libre' | 'distance' | 'lien' | 'lieu'; masque?: string }

/** Caractéristiques d'un logiciel : libre, accès à distance, guides */
const caracteristiques = (l: Record<string, string>): Pastille[] =>
  [
    l.libre === 'Oui' && { libelle: 'Logiciel libre', variante: 'jaune', icone: 'libre' },
    l.distance === 'Oui' && { libelle: 'Accès à distance', lien: '/informatique/connexion-distance', variante: 'rose', icone: 'distance', masque: ` : ${l.nom}` },
    l.lien && { libelle: 'Guides', lien: l.lien, variante: 'bleu', icone: 'lien', masque: ` : ${l.nom}${externe(l.lien) ? ' (site externe)' : ''}` },
  ].filter(Boolean) as Pastille[]

/** Bibliothèques où l'utiliser */
const bibliotheques = (l: Record<string, string>): Pastille[] =>
  (l.bibliotheques ?? '')
    .split(';')
    .map((b) => b.trim())
    .filter(Boolean)
    .map((b) => ({ libelle: b, lien: LIENS_BIBLIOTHEQUES[b], variante: 'lieu', icone: 'lieu' }))
---

<ListeFiltrable nom="Logiciels" total={logiciels.length} categories={categories} unite="logiciel" unites="logiciels" consigne="Recherchez un logiciel ou filtrez par catégorie :">
  {
    logiciels.map((l) => {
      const etiquettes = caracteristiques(l)
      const lieux = bibliotheques(l)
      return (
        <FicheFiltrable nom={l.nom} href={l.lien || undefined} categorie={l.categorie || undefined} description={l.description || undefined} texte={`${l.nom} ${l.description}`}>
          {etiquettes.length > 0 && <Pastilles nom="Caractéristiques" pastilles={etiquettes} />}
          {lieux.length > 0 && <Pastilles nom="Où l’utiliser" pastilles={lieux} />}
        </FicheFiltrable>
      )
    })
  }
  <Fragment slot="vide">Vérifiez l’orthographe ou <a href={`mailto:${SITE.courriel}`}>écrivez-nous</a> si vous cherchez un logiciel précis.</Fragment>
</ListeFiltrable>
<script is:inline type="module" src={scriptListe}></script>
