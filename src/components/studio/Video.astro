---
/*
 * Directive `video` : le composant de harmonium (paquet npm). Une vidéo
 * YouTube, Loom, d'une autre plateforme (adresse d'intégration) ou un fichier
 * du site, en 16:9.
 *
 * YouTube, Loom et autres plateformes : rien ne vient de la plateforme avant
 * le clic (ni lecteur, ni vignette, ni témoin). Le bouton de lecture est
 * d'abord un lien vers la vidéo sur la plateforme (il fonctionne sans
 * JavaScript) ; bib-video.min.js le remplace au clic par le lecteur, qui
 * démarre et reçoit le focus. Il se rebranche de lui-même à chaque page
 * (astro:page-load). Fichier : <video controls> natif.
 * Le titre, obligatoire, nomme le lecteur et le lien (WCAG 4.1.2).
 */
import VideoHarmonium from 'harmonium/astro/Video.astro'
import scriptVideo from 'harmonium/dist/bib-video.min.js?url&no-inline'

interface Props {
  titre: string
  youtube?: string
  loom?: string
  fichier?: string
  /** Adresse d'intégration (iframe) d'une autre plateforme */
  integration?: string
}

const { titre, youtube, loom, fichier, integration } = Astro.props
---

<VideoHarmonium titre={titre} youtube={youtube} loom={loom} fichier={fichier} integration={integration} />
<script is:inline type="module" src={scriptVideo}></script>
