---
/*
 * Flèche vers la droite dans un cercle (lien interne) : l'icône de harmonium (paquet npm), sous l'interface des icônes
 * Phosphor qu'attendent les cartes et la directive :icone (size, color,
 * aria-label). La couleur passe par un <span> en display: contents, dont
 * l'icône (fill: currentColor) hérite.
 */
import Icone from 'harmonium/astro/IconeFlecheDroiteCercle.astro'

interface Props {
  /** Nombre (px) ou longueur CSS */
  size?: number | string
  /** Couleur CSS (de préférence un jeton) ; currentColor par défaut */
  color?: string
  'aria-label'?: string
  class?: string
  className?: string
  [attribut: string]: unknown
}

const { size = '1.5rem', color, 'aria-label': nom, class: classe, className } = Astro.props
const taille = typeof size === 'number' ? `${size}px` : size
---

<span style={`display:contents${color ? `;color:${color}` : ''}`}><Icone taille={taille} nom={nom} class:list={[classe, className]} /></span>
